  ];

  // Audit Logs
  let auditLogs = [
    { time: "10:28:41", type: "AUTH", msg: "Session authenticated via Bearer token (admin@enterprise.co)", status: "OK" },
    { time: "10:25:12", type: "SYS", msg: "Automated snapshot backup verified: 2.4 GB to cold storage", status: "OK" },
    { time: "10:18:04", type: "NET", msg: "Cloudflare tunnel sync healthy (node: toshiba-l645)", status: "OK" },
    { time: "10:12:33", type: "TXN", msg: "Transaction TXN-9842 verified and locked in ledger", status: "OK" },
    { time: "09:45:01", type: "BATCH", msg: "Batch worker dispatched 128 payroll entries without errors", status: "OK" },
  ];

  function pushLog(type: string, msg: string, status: "OK" | "WARN" | "DENIED" = "OK") {
    const now = new Date();
    const time = now.toTimeString().slice(0, 8);
