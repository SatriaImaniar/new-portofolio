    {
      method: "DELETE",
      path: "/api/v1/sessions/{id}",
      title: "Revoke Active Session Token",
      desc: "Terminate an active user JWT session immediately from the Redis session cache.",
      status: 200,
      headers: {
        "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI...",
        "X-Request-ID": "req_revoke_44",
      },
      response: {
        success: true,
        message: "Session token invalidated and blacklisted.",
        revoked_at: "2026-11-05T10:28:41Z",
      },
    },
  ];

  // Pagination state
  const pageSize = 6;
  let currentPage = 1;
  let searchQuery = "";
  let statusFilter = "";
  let typeFilter = "";

  // Helper: syntax highlighting for JSON
  function formatJSON(obj: any): string {
    const json = JSON.stringify(obj, null, 2);
    return json
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g, (match) => {
        let cls = "text-amber-400";
        if (/^"/.test(match)) {
          if (/:$/.test(match)) {
            cls = "text-indigo-400 font-semibold";
          } else {
            cls = "text-emerald-400";
          }
        } else if (/true|false/.test(match)) {
          cls = "text-cyan-400";
        } else if (/null/.test(match)) {
          cls = "text-zinc-500";
        }
        return `<span class="${cls}">${match}</span>`;
      });
  }

  // Render Table
  function renderTable() {
    const tbody = document.getElementById("records-table-body");
    const info = document.getElementById("pagination-info");
    const controls = document.getElementById("pagination-controls");
    if (!tbody || !info || !controls) return;

    // Filter records
    const filtered = records.filter((r) => {
      const matchSearch =
        !searchQuery ||
        r.id.toLowerCase().includes(searchQuery.toLowerCase()) ||
        r.desc.toLowerCase().includes(searchQuery.toLowerCase());
      const matchStatus = !statusFilter || r.status === statusFilter;
      const matchType = !typeFilter || r.type === typeFilter;
      return matchSearch && matchStatus && matchType;
    });

    const totalPages = Math.ceil(filtered.length / pageSize) || 1;
    if (currentPage > totalPages) currentPage = totalPages;
    const startIdx = (currentPage - 1) * pageSize;
    const pageRecords = filtered.slice(startIdx, startIdx + pageSize);

    // Update info text
    const endIdx = Math.min(startIdx + pageSize, filtered.length);
    const lang = document.documentElement.getAttribute("lang") || "en";
    info.textContent =
      lang === "id"
        ? `Menampilkan ${filtered.length > 0 ? startIdx + 1 : 0}–${endIdx} dari ${filtered.length} data`
        : `Showing ${filtered.length > 0 ? startIdx + 1 : 0}–${endIdx} of ${filtered.length} records`;

    // Render Rows
    if (pageRecords.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" class="px-5 py-12 text-center text-zinc-500 font-mono text-xs">
            No matching records found.
          </td>
        </tr>
      `;
    } else {
      const rolePerm = permissions[activeRole];

      tbody.innerHTML = pageRecords
        .map((r) => {
          // Status badge
          let statusBadge = "";
          if (r.status === "completed") {
            statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">✓ Completed</span>`;
          } else if (r.status === "pending") {
            statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">⏳ Pending</span>`;
          } else {
            statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-red-500/10 text-red-400 border border-red-500/20">✕ Failed</span>`;
          }

          // Type badge
          let typeIcon = "💳";
          let typeLabel = "Transaction";
          if (r.type === "access") {
            typeIcon = "🔑";
            typeLabel = "Access Control";
          } else if (r.type === "webhook") {
            typeIcon = "🔗";
            typeLabel = "Webhook";
          }

          // Actions based on active role
          let actionsHtml = `<div class="flex items-center justify-end gap-1.5">`;

          // View Payload is always allowed
          actionsHtml += `
            <button
              type="button"
              data-action="view"
              data-id="${r.id}"
              class="px-2 py-1 text-[11px] font-medium text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 rounded transition-colors"
            >
              Payload
            </button>
          `;

          // Edit is allowed for admin only
          if (rolePerm.allowEdit) {
            actionsHtml += `
              <button
                type="button"
                data-action="edit"
                data-id="${r.id}"
                class="px-2 py-1 text-[11px] font-medium text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 rounded transition-colors"
              >
                Edit
              </button>
            `;
          }

          // Trigger Webhook is allowed for admin on webhook rows
          if (rolePerm.allowWebhook && r.type === "webhook") {
            actionsHtml += `
              <button
                type="button"
                data-action="trigger"
                data-id="${r.id}"
                class="px-2 py-1 text-[11px] font-medium text-indigo-400 hover:text-indigo-200 bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/30 rounded transition-colors"
              >
                Trigger
              </button>
            `;
          }

          actionsHtml += `</div>`;

          return `
            <tr class="hover:bg-zinc-800/30 transition-colors">
              <td class="px-5 py-3 font-mono font-medium text-indigo-400">${r.id}</td>
              <td class="px-5 py-3">
                <span class="inline-flex items-center gap-1.5 text-zinc-300">
                  <span>${typeIcon}</span>
                  <span class="capitalize">${typeLabel}</span>
                </span>
              </td>
              <td class="px-5 py-3 text-zinc-300 max-w-xs truncate">${r.desc}</td>
              <td class="px-5 py-3">${statusBadge}</td>
              <td class="px-5 py-3 font-mono text-zinc-500">${r.ts}</td>
              <td class="px-5 py-3 text-right">${actionsHtml}</td>
            </tr>
          `;
        })
        .join("");
    }

    // Render Pagination Controls
    let pagesHtml = `
      <button
        type="button"
        id="btn-prev-page"
        ${currentPage <= 1 ? "disabled" : ""}
        class="px-2.5 py-1 text-xs rounded border border-zinc-800 bg-zinc-900 text-zinc-400 hover:text-white disabled:opacity-30 disabled:pointer-events-none transition-colors"
      >
        ←
      </button>
    `;

    for (let p = 1; p <= totalPages; p++) {
      const isActive = p === currentPage;
      pagesHtml += `
        <button
          type="button"
          data-page="${p}"
          class="page-num-btn px-2.5 py-1 text-xs rounded border ${
            isActive
              ? "border-indigo-500 bg-indigo-500/20 text-indigo-300 font-semibold"
              : "border-zinc-800 bg-zinc-900 text-zinc-400 hover:text-white"
          } transition-colors"
        >
          ${p}
        </button>
      `;
    }

    pagesHtml += `
      <button
        type="button"
        id="btn-next-page"
        ${currentPage >= totalPages ? "disabled" : ""}
        class="px-2.5 py-1 text-xs rounded border border-zinc-800 bg-zinc-900 text-zinc-400 hover:text-white disabled:opacity-30 disabled:pointer-events-none transition-colors"
      >
        →
      </button>
    `;

    controls.innerHTML = pagesHtml;

    // Attach listeners
    document.getElementById("btn-prev-page")?.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage--;
        renderTable();
      }
    });

    document.getElementById("btn-next-page")?.addEventListener("click", () => {
      if (currentPage < totalPages) {
        currentPage++;
        renderTable();
      }
    });

    controls.querySelectorAll(".page-num-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const targetPage = Number((e.currentTarget as HTMLElement).getAttribute("data-page"));
        if (targetPage && targetPage !== currentPage) {
          currentPage = targetPage;
          renderTable();
        }
      });
    });

    // Row action buttons
    tbody.querySelectorAll("button[data-action]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const action = (e.currentTarget as HTMLElement).getAttribute("data-action");
        const id = (e.currentTarget as HTMLElement).getAttribute("data-id");
        if (action === "view" && id) openPayloadModal(id);
        if (action === "edit" && id) openEditModal(id);
        if (action === "trigger" && id) openTriggerModal(id);
      });
    });
  }

  // Render REST API Inspector Accordion
  function renderApiAccordion() {
    const container = document.getElementById("api-endpoints-accordion");
    if (!container) return;

    container.innerHTML = endpoints
      .map((ep, idx) => {
        let methodColor = "bg-emerald-500/10 text-emerald-400 border-emerald-500/30";
        if (ep.method === "POST") methodColor = "bg-blue-500/10 text-blue-400 border-blue-500/30";
        if (ep.method === "PUT") methodColor = "bg-amber-500/10 text-amber-400 border-amber-500/30";
        if (ep.method === "DELETE") methodColor = "bg-red-500/10 text-red-400 border-red-500/30";

        return `
          <div class="border border-zinc-800/80 rounded-xl bg-zinc-950/40 overflow-hidden">
            <!-- Accordion Header -->
            <button
              type="button"
              data-endpoint-toggle="${idx}"
              class="w-full flex items-center justify-between p-4 text-left hover:bg-zinc-800/20 transition-colors"
            >
              <div class="flex items-center gap-3 min-w-0">
                <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold border ${methodColor}">
                  ${ep.method}
                </span>
                <span class="font-mono text-xs font-semibold text-zinc-200 truncate">
                  ${ep.path}
                </span>
                <span class="text-xs text-zinc-500 hidden md:inline truncate">
                  — ${ep.title}
                </span>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <span class="text-[11px] font-mono text-emerald-400 px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20">
                  ${ep.status} OK
                </span>
                <svg class="w-4 h-4 text-zinc-400 transition-transform duration-200" id="accordion-arrow-${idx}" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </button>

            <!-- Accordion Details (Hidden by default, index 0 open) -->
            <div id="accordion-body-${idx}" class="${idx === 0 ? "" : "hidden"} p-4 sm:p-5 border-t border-zinc-800/80 bg-zinc-950/80 space-y-4">
              <p class="text-xs text-zinc-400">${ep.desc}</p>
              
              <!-- Headers Section -->
              <div>
                <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-500">Request Headers</span>
                <div class="mt-1.5 p-3 rounded-lg bg-zinc-900 border border-zinc-800 font-mono text-[11px] space-y-1">
                  ${Object.entries(ep.headers)
                    .map(([k, v]) => `<div><span class="text-indigo-400 font-semibold">${k}:</span> <span class="text-zinc-300">${v}</span></div>`)
                    .join("")}
                </div>
              </div>

              <!-- Request Body if present -->
              ${
                ep.body
                  ? `
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-500">Request Payload (JSON)</span>
                  <pre class="mt-1.5 p-3 rounded-lg bg-zinc-900 border border-zinc-800 font-mono text-[11px] overflow-x-auto text-zinc-300"><code>${formatJSON(
                    ep.body
                  )}</code></pre>
                </div>
              `
                  : ""
              }

              <!-- Response Body -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-500">Mock JSON Response (${ep.status})</span>
                  <button
                    type="button"
                    data-copy-curl="${idx}"
                    class="text-[11px] font-mono text-zinc-400 hover:text-white flex items-center gap-1 transition-colors"
                  >
                    <span>📋</span>
                    <span>Copy cURL</span>
                  </button>
                </div>
                <pre class="p-3.5 rounded-lg bg-zinc-900 border border-zinc-800 font-mono text-[11px] overflow-x-auto text-zinc-300 leading-relaxed"><code>${formatJSON(
                  ep.response
                )}</code></pre>
              </div>
            </div>
          </div>
        `;
      })
      .join("");

    // Hook up accordion toggles
    container.querySelectorAll("button[data-endpoint-toggle]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const idx = (e.currentTarget as HTMLElement).getAttribute("data-endpoint-toggle");
        const body = document.getElementById(`accordion-body-${idx}`);
        const arrow = document.getElementById(`accordion-arrow-${idx}`);
        if (body && arrow) {
          const isHidden = body.classList.toggle("hidden");
          arrow.style.transform = isHidden ? "" : "rotate(180deg)";
        }
      });
    });

    // Copy cURL handlers
    container.querySelectorAll("button[data-copy-curl]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const idx = Number((e.currentTarget as HTMLElement).getAttribute("data-copy-curl"));
        const ep = endpoints[idx];
        const curlCmd = `curl -X ${ep.method} "https://api.enterprise.co${ep.path}" \\\n  -H "Authorization: ${ep.headers.Authorization}" \\\n  -H "Accept: application/json"`;
        navigator.clipboard.writeText(curlCmd).then(() => {
          const label = (e.currentTarget as HTMLElement).querySelector("span:last-child");
          if (label) {
            const oldText = label.textContent;
            label.textContent = "Copied!";
            setTimeout(() => {
              label.textContent = oldText;
            }, 1500);
          }
        });
        pushLog("API", `Inspected and copied cURL for ${ep.method} ${ep.path}`);
      });
    });
  }

  // Render Audit Logs
  function renderAuditLogs() {
    const container = document.getElementById("audit-logs-container");
    if (!container) return;

    container.innerHTML = auditLogs
      .map((log) => {
        let badgeColor = "text-emerald-400 bg-emerald-500/10 border-emerald-500/20";
        if (log.status === "WARN") badgeColor = "text-amber-400 bg-amber-500/10 border-amber-500/20";
        if (log.status === "DENIED") badgeColor = "text-red-400 bg-red-500/10 border-red-500/20";

        return `
          <div class="flex items-start gap-3 p-2.5 rounded-lg bg-zinc-950/60 border border-zinc-800/60 hover:border-zinc-700/60 transition-colors">
            <span class="text-zinc-500 font-mono text-[11px] whitespace-nowrap">${log.time}</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono border ${badgeColor}">${log.type}</span>
            <span class="text-zinc-300 flex-1 leading-relaxed text-xs">${log.msg}</span>
            <span class="text-[10px] font-mono text-zinc-500">${log.status}</span>
          </div>
        `;
      })
      .join("");
  }

  // Switch Active RBAC Role
  function setRole(role: "admin" | "finance" | "auditor") {
    activeRole = role;
    const rolePerm = permissions[role];
    const lang = document.documentElement.getAttribute("lang") || "en";

    // Update Role Switcher Buttons
    document.querySelectorAll(".role-switch-btn").forEach((btn) => {
      const r = btn.getAttribute("data-role");
      if (r === role) {
        btn.className =
          "role-switch-btn flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium rounded-lg transition-all duration-150 bg-indigo-600 text-white shadow-sm shadow-indigo-600/30";
      } else {
        btn.className =
          "role-switch-btn flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium rounded-lg text-zinc-400 hover:text-zinc-200 transition-all duration-150";
      }
    });

    // Update Banner
    const banner = document.getElementById("perm-banner");
    const roleLabel = document.getElementById("perm-role-label");
    const bannerText = document.getElementById("perm-banner-text");
    const scopeBadge = document.getElementById("perm-scope-badge");

    if (banner) {
      banner.className = `flex items-center gap-3 px-4 py-3 rounded-xl border text-xs transition-all duration-200 ${rolePerm.bannerClass}`;
    }
    if (roleLabel) {
      roleLabel.textContent = `Active Role: ${rolePerm.name}`;
    }
    if (bannerText) {
      bannerText.textContent = lang === "id" ? rolePerm.permTextId : rolePerm.permTextEn;
    }
    if (scopeBadge) {
      scopeBadge.innerHTML = `Scope: <span class="font-semibold">${rolePerm.scope}</span>`;
    }

    // Toggle Add Record button visibility
    const btnAdd = document.getElementById("btn-add-record");
    if (btnAdd) {
      btnAdd.style.display = rolePerm.allowAdd ? "inline-flex" : "none";
    }

    // Toggle API Inspector Tab
    const tabApiBtn = document.getElementById("tab-btn-api");
    if (tabApiBtn) {
      tabApiBtn.style.display = rolePerm.allowApiTab ? "inline-flex" : "none";
    }

    // If currently in API tab and role doesn't allow it, fallback to records
    const panelApi = document.getElementById("tab-panel-api");
    if (!rolePerm.allowApiTab && panelApi && !panelApi.classList.contains("hidden")) {
      switchTab("records");
    }

    // Toggle Audit Card
    const auditCard = document.getElementById("card-metric-audit");
    if (auditCard) {
      auditCard.style.opacity = rolePerm.showAuditCard ? "1" : "0.3";
      auditCard.style.filter = rolePerm.showAuditCard ? "none" : "grayscale(100%)";
    }

    // Re-render table with new action buttons
    renderTable();

    // Log the event
    pushLog("RBAC", `Switched identity context to ${rolePerm.name} (${rolePerm.scope})`);
  }

  // Tab switching logic
  function switchTab(tabId: "records" | "api" | "logs") {
    document.querySelectorAll(".tab-nav-btn").forEach((btn) => {
      const target = btn.getAttribute("data-tab");
      if (target === tabId) {
        btn.className =
          "tab-nav-btn px-4 py-2 rounded-lg text-xs font-medium transition-colors bg-zinc-800 text-white shadow-sm flex items-center gap-2";
      } else {
        btn.className =
          "tab-nav-btn px-4 py-2 rounded-lg text-xs font-medium transition-colors text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40 flex items-center gap-2";
      }
    });

    document.querySelectorAll(".tab-panel").forEach((panel) => {
      panel.classList.add("hidden");
    });

    const activePanel = document.getElementById(`tab-panel-${tabId}`);
    if (activePanel) {
      activePanel.classList.remove("hidden");
    }

    pushLog("NAV", `Navigated to workspace panel: ${tabId.toUpperCase()}`);
  }

  // Modal helpers
  const modal = document.getElementById("global-modal");
  const modalBox = document.getElementById("modal-box");
  const modalTitle = document.getElementById("modal-title");
  const modalContent = document.getElementById("modal-content");
  const btnCloseModal = document.getElementById("btn-close-modal");

  function openModal(title: string, contentHtml: string) {
    if (!modal || !modalBox || !modalTitle || !modalContent) return;
    modalTitle.innerHTML = title;
    modalContent.innerHTML = contentHtml;
    modal.classList.remove("hidden");
    setTimeout(() => {
      modal.classList.remove("opacity-0");
      modalBox.classList.remove("scale-95");
      modalBox.classList.add("scale-100");
    }, 10);
  }

  function closeModal() {
    if (!modal || !modalBox) return;
    modal.classList.add("opacity-0");
    modalBox.classList.remove("scale-100");
    modalBox.classList.add("scale-95");
    setTimeout(() => {
      modal.classList.add("hidden");
    }, 200);
  }

  btnCloseModal?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  // Action: Open Payload Modal
  function openPayloadModal(id: string) {
    const record = records.find((r) => r.id === id);
    if (!record) return;

    const payload = {
      record_id: record.id,
      system_type: record.type,
      description: record.desc,
      status: record.status,
      timestamp: record.ts,
      actor: record.actor || "system",
      details: record.amount ? { amount_usd: record.amount, currency: "USD", cleared: true } : { processed: true },
      security_hash: `sha256:${record.id.toLowerCase()}_99a1b`,
      _links: {
        self: `/api/v1/records/${record.id}`,
        audit: `/api/v1/audit/logs?ref=${record.id}`,
      },
    };

    openModal(
      `<span class="text-indigo-400">📦</span> Record Payload: ${record.id}`,
      `
        <div class="space-y-3">
          <div class="flex items-center justify-between text-[11px] font-mono text-zinc-400 pb-2 border-b border-zinc-800">
            <span>GET /api/v1/records/${record.id}</span>
            <span class="text-emerald-400">200 OK (14ms)</span>
          </div>
          <pre class="p-3.5 rounded-lg bg-zinc-950 border border-zinc-800 font-mono text-[11px] overflow-x-auto text-zinc-300 leading-relaxed"><code>${formatJSON(
            payload
          )}</code></pre>
          <div class="flex justify-end gap-2 pt-2">
            <button
              type="button"
              id="btn-copy-payload"
              class="px-3 py-1.5 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors"
            >
              Copy JSON
            </button>
            <button
              type="button"
              id="btn-dismiss-modal"
              class="px-3 py-1.5 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-800 rounded-lg transition-colors"
            >
              Close
            </button>
          </div>
        </div>
      `
    );

    document.getElementById("btn-copy-payload")?.addEventListener("click", () => {
      navigator.clipboard.writeText(JSON.stringify(payload, null, 2)).then(() => {
        const btn = document.getElementById("btn-copy-payload");
        if (btn) btn.textContent = "Copied!";
        setTimeout(() => {
          if (btn) btn.textContent = "Copy JSON";
        }, 1500);
      });
    });

    document.getElementById("btn-dismiss-modal")?.addEventListener("click", closeModal);
    pushLog("PAYLOAD", `Inspected JSON payload for ${record.id}`);
  }

  // Action: Open Edit Modal
  function openEditModal(id: string) {
    const record = records.find((r) => r.id === id);
    if (!record) return;

    openModal(
      `<span class="text-amber-400">✏️</span> Edit Record: ${record.id}`,
      `
        <form id="form-edit-record" class="space-y-4">
          <div>
            <label class="block text-zinc-400 text-xs mb-1 font-mono">Description</label>
            <input
              type="text"
              id="edit-desc"
              value="${record.desc}"
              required
              class="w-full px-3 py-2 text-xs bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-200 focus:outline-none focus:border-indigo-500"
            />
          </div>

          <div>
            <label class="block text-zinc-400 text-xs mb-1 font-mono">Status</label>
            <select
              id="edit-status"
              class="w-full px-3 py-2 text-xs bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-200 focus:outline-none focus:border-indigo-500"
            >
              <option value="completed" ${record.status === "completed" ? "selected" : ""}>Completed</option>
              <option value="pending" ${record.status === "pending" ? "selected" : ""}>Pending</option>
              <option value="failed" ${record.status === "failed" ? "selected" : ""}>Failed</option>
            </select>
          </div>

          <div class="flex justify-end gap-2 pt-3 border-t border-zinc-800">
            <button
              type="button"
              id="btn-edit-cancel"
              class="px-3.5 py-1.5 text-xs text-zinc-400 hover:text-white bg-zinc-800 rounded-lg"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-3.5 py-1.5 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors"
            >
              Save Changes
            </button>
          </div>
        </form>
      `
    );

    document.getElementById("btn-edit-cancel")?.addEventListener("click", closeModal);

    document.getElementById("form-edit-record")?.addEventListener("submit", (e) => {
      e.preventDefault();
      const newDesc = (document.getElementById("edit-desc") as HTMLInputElement).value;
      const newStatus = (document.getElementById("edit-status") as HTMLSelectElement).value as any;

      record.desc = newDesc;
      record.status = newStatus;
      renderTable();
      closeModal();
      pushLog("CRUD", `Updated record ${record.id}: description & status (${newStatus})`);
    });
  }

  // Action: Open Trigger Webhook Modal
  function openTriggerModal(id: string) {
    const record = records.find((r) => r.id === id);
    if (!record) return;

    openModal(
      `<span class="text-indigo-400">🔗</span> Trigger Webhook Dispatch: ${record.id}`,
      `
        <div class="space-y-4">
          <p class="text-xs text-zinc-300">
            Dispatch an asynchronous HTTP POST event payload to the target subscriber URL.
          </p>

          <div class="p-3 rounded-lg bg-zinc-950 border border-zinc-800 font-mono text-[11px] space-y-1 text-zinc-400">
            <div><span class="text-indigo-400">POST</span> /api/v1/webhooks/${record.id}/dispatch</div>
            <div><span class="text-zinc-500">Target:</span> https://hooks.slack.com/services/...</div>
            <div><span class="text-zinc-500">Retry Count:</span> 0/3 · Timeout: 5000ms</div>
          </div>

          <div class="flex justify-end gap-2 pt-2">
            <button
              type="button"
              id="btn-trigger-cancel"
              class="px-3.5 py-1.5 text-xs text-zinc-400 hover:text-white bg-zinc-800 rounded-lg"
            >
              Cancel
            </button>
            <button
              type="button"
              id="btn-trigger-confirm"
              class="px-3.5 py-1.5 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors"
            >
              Confirm Dispatch
            </button>
          </div>
        </div>
      `
    );

    document.getElementById("btn-trigger-cancel")?.addEventListener("click", closeModal);

    document.getElementById("btn-trigger-confirm")?.addEventListener("click", () => {
      record.status = "completed";
      renderTable();
      closeModal();
      pushLog("WEBHOOK", `Dispatched webhook ${record.id} with status 200 OK`);
    });
  }

  // Action: Open Add Record Modal
  document.getElementById("btn-add-record")?.addEventListener("click", () => {
    openModal(
      `<span class="text-emerald-400">➕</span> Add New Enterprise Record`,
      `
        <form id="form-add-record" class="space-y-4">
          <div>
            <label class="block text-zinc-400 text-xs mb-1 font-mono">Record Type</label>
            <select
              id="new-type"
              class="w-full px-3 py-2 text-xs bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-200 focus:outline-none focus:border-indigo-500"
            >
              <option value="transaction">Transaction (Ledger)</option>
              <option value="access">Access Control (ACL)</option>
              <option value="webhook">Webhook Dispatch</option>
            </select>
          </div>

          <div>
            <label class="block text-zinc-400 text-xs mb-1 font-mono">Description</label>
            <input
              type="text"
              id="new-desc"
              placeholder="e.g. Database schema migration executed"
              required
              class="w-full px-3 py-2 text-xs bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-200 focus:outline-none focus:border-indigo-500"
            />
          </div>

          <div class="flex justify-end gap-2 pt-3 border-t border-zinc-800">
            <button
              type="button"
              id="btn-add-cancel"
              class="px-3.5 py-1.5 text-xs text-zinc-400 hover:text-white bg-zinc-800 rounded-lg"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-3.5 py-1.5 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors"
            >
              Create Record
            </button>
          </div>
        </form>
      `
    );

    document.getElementById("btn-add-cancel")?.addEventListener("click", closeModal);

    document.getElementById("form-add-record")?.addEventListener("submit", (e) => {
      e.preventDefault();
      const type = (document.getElementById("new-type") as HTMLSelectElement).value as any;
      const desc = (document.getElementById("new-desc") as HTMLInputElement).value;
      const randNum = Math.floor(1000 + Math.random() * 9000);
      const prefix = type === "transaction" ? "TXN" : type === "access" ? "ACL" : "WHK";
      const newId = `${prefix}-${randNum}`;
      const now = new Date();
      const ts = now.toISOString().replace("T", " ").slice(0, 19);

      records.unshift({
        id: newId,
        type,
        desc,
        status: "completed",
        ts,
        actor: "admin@enterprise.co",
      });

      renderTable();
      closeModal();
      pushLog("CRUD", `Created new record: ${newId} (${type})`);
    });
  });

  // Action: Open API Docs Modal
  document.getElementById("btn-open-api-docs")?.addEventListener("click", () => {
    openModal(
      `<span class="text-indigo-400">📖</span> EnterpriseCore API Documentation (v2.4)`,
      `
        <div class="space-y-4">
          <p class="text-xs text-zinc-300">
            EnterpriseCore provides RESTful endpoints designed around JSON:API conventions. Every mutation is tracked in an append-only audit ledger.
          </p>

          <div class="space-y-2">
            <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-500">Base URL & Protocols</span>
            <div class="p-3 rounded-lg bg-zinc-950 border border-zinc-800 font-mono text-xs text-emerald-400">
              https://api.enterprise.co/v1
            </div>
          </div>

          <div class="space-y-2">
            <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-500">Authentication</span>
            <p class="text-xs text-zinc-400">All requests require Bearer token authorization in the HTTP headers:</p>
            <pre class="p-3 rounded-lg bg-zinc-950 border border-zinc-800 font-mono text-[11px] text-zinc-300"><code>Authorization: Bearer &lt;YOUR_API_TOKEN&gt;
Accept: application/json
Content-Type: application/json</code></pre>
          </div>

          <div class="space-y-2">
            <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-500">Rate Limits & SLAs</span>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <div class="p-2.5 rounded-lg bg-zinc-950 border border-zinc-800">
                <div class="text-zinc-500">Standard Tier</div>
                <div class="text-white font-mono font-semibold">1,200 req/min</div>
              </div>
              <div class="p-2.5 rounded-lg bg-zinc-950 border border-zinc-800">
                <div class="text-zinc-500">Production SLA</div>
                <div class="text-emerald-400 font-mono font-semibold">99.9% Uptime</div>
              </div>
            </div>
          </div>

          <div class="flex justify-end pt-2">
            <button
              type="button"
              id="btn-docs-close"
              class="px-3.5 py-1.5 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors"
            >
              Done
            </button>
          </div>
        </div>
      `
    );

    document.getElementById("btn-docs-close")?.addEventListener("click", closeModal);
    pushLog("DOCS", "Consulted official API documentation specification");
  });

  // Reset Simulator
  document.getElementById("btn-clear-logs")?.addEventListener("click", () => {
    auditLogs = [
      { time: new Date().toTimeString().slice(0, 8), type: "RESET", msg: "Simulator state re-initialized", status: "OK" },
    ];
    renderAuditLogs();
  });

  // Search & Filter event listeners
  document.getElementById("records-search")?.addEventListener("input", (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    currentPage = 1;
    renderTable();
  });

  document.getElementById("filter-status")?.addEventListener("change", (e) => {
    statusFilter = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    renderTable();
  });

  document.getElementById("filter-type")?.addEventListener("change", (e) => {
    typeFilter = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    renderTable();
  });

  // Role button listeners
  document.querySelectorAll(".role-switch-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const role = (e.currentTarget as HTMLElement).getAttribute("data-role") as any;
      if (role) setRole(role);
    });
  });

  // Tab button listeners
  document.querySelectorAll(".tab-nav-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const tab = (e.currentTarget as HTMLElement).getAttribute("data-tab") as any;
      if (tab) switchTab(tab);
    });
  });

  // Real-time metrics drift simulation (Every 4 seconds)
  setInterval(() => {
    const usersEl = document.getElementById("metric-users-val");
    const queryEl = document.getElementById("metric-query-val");
    const querySub = document.getElementById("metric-query-sub");
    const tpEl = document.getElementById("metric-throughput-val");

    if (usersEl) {
      const delta = Math.floor(Math.random() * 9) - 4;
      const current = parseInt(usersEl.textContent?.replace(/,/g, "") || "2847", 10);
      usersEl.textContent = (current + delta).toLocaleString();
    }

    if (queryEl && querySub) {
      const latency = 22 + Math.floor(Math.random() * 5);
      queryEl.textContent = `avg. ${latency}ms`;
      querySub.textContent = `P99: ${84 + Math.floor(Math.random() * 8)}ms · 142k queries`;
    }

    if (tpEl) {
      const val = (1.18 + Math.random() * 0.08).toFixed(2);
      tpEl.textContent = `${val}k req/min`;
    }
  }, 4000);

  // Sync with Portfolio language change event
  window.addEventListener("portfolio-lang-change", () => {
    setRole(activeRole);
    renderTable();
  });

  // Initialize
  setRole("admin");
  renderTable();
  renderApiAccordion();
  renderAuditLogs();
</script>

