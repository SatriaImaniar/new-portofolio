      headers: {
        "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI...",
        "Accept": "application/json",
      },
      response: {
        success: true,
        data: [
          { id: 1, name: "Satria Imaniar", email: "admin@enterprise.co", role: "admin", mfa_enabled: true },
          { id: 2, name: "Finance Director", email: "finance@enterprise.co", role: "finance_manager", mfa_enabled: true },
