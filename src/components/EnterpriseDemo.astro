---
// EnterpriseDemo.astro
// Interactive Production Demo for "Enterprise Management System & REST API"
// Inspired by Vercel / Linear / Laravel Nova aesthetics.
// Fully bilingual-ready, role-based access control, CRUD simulation, and REST API inspector.
---

<div class="enterprise-demo min-h-screen bg-zinc-950 text-zinc-300 font-sans antialiased selection:bg-indigo-500/20 selection:text-indigo-200">
  
  <!-- ═══════════════ TOP NAVIGATION / HEADER ═══════════════ -->
  <header class="sticky top-0 z-40 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8">
      
      <!-- Brand & Status -->
      <div class="flex items-center gap-3.5">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 shadow-sm shadow-indigo-500/10">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-white font-semibold text-sm tracking-tight" data-i18n="demo.enterprise.title">EnterpriseCore v2.4 (Production)</span>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">LIVE</span>
            </div>
            <p class="text-[11px] text-zinc-500 hidden sm:block" data-i18n="demo.enterprise.subtitle">Interactive Enterprise Management System & REST API Control Plane</p>
          </div>
        </div>

        <!-- Uptime / Connection Badge -->
        <div class="hidden md:flex items-center gap-2 ml-4 pl-4 border-l border-zinc-800/80">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-xs font-mono text-zinc-400" data-i18n="demo.enterprise.badge">API Connected (99.9% Uptime)</span>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- API Docs Modal Trigger -->
        <button
          type="button"
          id="btn-open-api-docs"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-300 hover:text-white bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 rounded-lg transition-colors duration-150 shadow-sm"
        >
          <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <span data-i18n="demo.enterprise.apiDocs">API Docs</span>
        </button>

        <!-- Portfolio Native Language Switcher -->
        <button
          type="button"
          class="lang-toggle-btn inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-mono rounded-lg border border-zinc-800 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 transition-colors"
          aria-label="Switch language (EN/ID)"
          title="Switch language"
        >
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="1.5"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
          </svg>
          <span class="lang-indicator-en font-semibold text-white">EN</span>
          <span class="text-zinc-600">/</span>
          <span class="lang-indicator-id text-zinc-500 font-normal">ID</span>
        </button>

        <!-- Back to Portfolio Link -->
        <a
          href="/#projects"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 rounded-lg transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span data-i18n="demo.enterprise.back">Back to Portfolio</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ═══════════════ MAIN CONTENT CONTAINER ═══════════════ -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- ── SECTION 1: ROLE-BASED ACCESS CONTROL (RBAC) SWITCHER ── -->
    <section class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-4 sm:p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 backdrop-blur-sm">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
          <span class="text-xs font-mono uppercase tracking-wider text-zinc-500">RBAC Identity Switcher</span>
        </div>
        <h2 class="text-base sm:text-lg font-semibold text-white tracking-tight mt-1">
          Role-Based Access Control Simulation
        </h2>
        <p class="text-xs text-zinc-400 mt-0.5">
          Toggle roles in real time to observe dynamic permission scoping, route filtering, and restricted actions.
        </p>
      </div>

      <!-- Role Buttons -->
      <div class="flex items-center p-1 bg-zinc-950/80 border border-zinc-800 rounded-xl" id="role-switcher-container">
        <button
          type="button"
          data-role="admin"
          class="role-switch-btn flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium rounded-lg transition-all duration-150 bg-indigo-600 text-white shadow-sm shadow-indigo-600/30"
        >
          <span>🛡️</span>
          <span data-i18n="demo.enterprise.roleAdmin">Admin</span>
        </button>
        <button
          type="button"
          data-role="finance"
          class="role-switch-btn flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium rounded-lg text-zinc-400 hover:text-zinc-200 transition-all duration-150"
        >
          <span>💰</span>
          <span data-i18n="demo.enterprise.roleFinance">Finance Manager</span>
        </button>
        <button
          type="button"
          data-role="auditor"
          class="role-switch-btn flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium rounded-lg text-zinc-400 hover:text-zinc-200 transition-all duration-150"
        >
          <span>🔍</span>
          <span data-i18n="demo.enterprise.roleAuditor">System Auditor</span>
        </button>
      </div>
    </section>

    <!-- ── DYNAMIC PERMISSION BANNER ── -->
    <div
      id="perm-banner"
      class="flex items-center gap-3 px-4 py-3 rounded-xl border text-xs transition-all duration-200 border-indigo-500/30 bg-indigo-500/5 text-indigo-300"
    >
      <div class="p-1 rounded-md bg-indigo-500/20 text-indigo-400 flex-shrink-0" id="perm-banner-icon">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
      </div>
      <div class="flex-1">
        <span class="font-semibold text-white mr-1.5" id="perm-role-label">Active Role: Administrator</span>
        <span id="perm-banner-text" data-i18n="demo.enterprise.permAdmin">
          Full administrative access — all modules, CRUD mutations, webhooks, and endpoint tester are authorized.
        </span>
      </div>
      <div class="text-[11px] font-mono text-zinc-500 hidden sm:block" id="perm-scope-badge">
        Scope: <span class="text-indigo-400 font-semibold">ALL_PERMISSIONS</span>
      </div>
    </div>

    <!-- ── SECTION 2: REAL-TIME ANALYTICS & METRICS OVERVIEW CARDS ── -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="metrics-grid">
      <!-- Metric 1: Active Users -->
      <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-all duration-200 group">
        <div class="flex items-center justify-between text-zinc-500 mb-2">
          <span class="text-xs font-medium uppercase tracking-wider" data-i18n="demo.enterprise.metricUsers">Active Users / Sessions</span>
          <div class="w-7 h-7 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
        </div>
        <div class="text-2xl sm:text-3xl font-bold font-mono text-white tracking-tight" id="metric-users-val">
          2,847
        </div>
        <div class="flex items-center gap-1.5 mt-2 text-[11px] text-emerald-400">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
          <span>+12.4% vs last hour</span>
          <span class="text-zinc-500 ml-auto font-mono">JWT / Sanctum</span>
        </div>
      </div>

      <!-- Metric 2: DB Query Performance -->
      <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-all duration-200 group">
        <div class="flex items-center justify-between text-zinc-500 mb-2">
          <span class="text-xs font-medium uppercase tracking-wider" data-i18n="demo.enterprise.metricQuery">Database Query Perf</span>
          <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
        </div>
        <div class="text-2xl sm:text-3xl font-bold font-mono text-white tracking-tight" id="metric-query-val">
          avg. 24ms
        </div>
        <div class="flex items-center gap-1.5 mt-2 text-[11px] text-zinc-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span id="metric-query-sub">P99: 89ms · 142k queries</span>
          <span class="text-zinc-500 ml-auto font-mono">MySQL 8.0</span>
        </div>
      </div>

      <!-- Metric 3: API Request Throughput -->
      <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-all duration-200 group">
        <div class="flex items-center justify-between text-zinc-500 mb-2">
          <span class="text-xs font-medium uppercase tracking-wider" data-i18n="demo.enterprise.metricThroughput">API Request Throughput</span>
          <div class="w-7 h-7 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
        </div>
        <div class="text-2xl sm:text-3xl font-bold font-mono text-white tracking-tight" id="metric-throughput-val">
          1.2k req/min
        </div>
        <div class="flex items-center gap-1.5 mt-2 text-[11px] text-emerald-400">
          <span class="text-zinc-400">0.02% error rate</span>
          <span class="text-zinc-500 ml-auto font-mono">Nginx + Octane</span>
        </div>
      </div>

      <!-- Metric 4: Security Audit Status -->
      <div id="card-metric-audit" class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-all duration-200 group">
        <div class="flex items-center justify-between text-zinc-500 mb-2">
          <span class="text-xs font-medium uppercase tracking-wider" data-i18n="demo.enterprise.metricAudit">Security Audit Status</span>
          <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
        </div>
        <div class="text-2xl sm:text-3xl font-bold font-mono text-emerald-400 tracking-tight">
          Passed ✓
        </div>
        <div class="flex items-center gap-1.5 mt-2 text-[11px] text-zinc-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>SOC2 & ISO 27001</span>
          <span class="text-zinc-500 ml-auto font-mono">2 min ago</span>
        </div>
      </div>
    </section>

    <!-- ── SECTION 3: MAIN WORKSPACE (TABS: RECORDS / API INSPECTOR / AUDIT LOGS) ── -->
    <section class="border border-zinc-800/80 rounded-2xl bg-zinc-900/40 backdrop-blur-sm overflow-hidden shadow-xl shadow-black/40">
      
      <!-- Tab Header Strip -->
      <div class="flex items-center justify-between border-b border-zinc-800/80 px-4 sm:px-6 bg-zinc-900/60 overflow-x-auto">
        <div class="flex space-x-1 sm:space-x-2 py-2.5">
          <button
            type="button"
            data-tab="records"
            class="tab-nav-btn px-4 py-2 rounded-lg text-xs font-medium transition-colors bg-zinc-800 text-white shadow-sm flex items-center gap-2"
          >
            <span>📋</span>
            <span data-i18n="demo.enterprise.tabRecords">Records & CRUD</span>
          </button>
          
          <button
            type="button"
            id="tab-btn-api"
            data-tab="api"
            class="tab-nav-btn px-4 py-2 rounded-lg text-xs font-medium transition-colors text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40 flex items-center gap-2"
          >
            <span>⚡</span>
            <span data-i18n="demo.enterprise.tabApi">REST API Inspector</span>
          </button>

          <button
            type="button"
            data-tab="logs"
            class="tab-nav-btn px-4 py-2 rounded-lg text-xs font-medium transition-colors text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40 flex items-center gap-2"
          >
            <span>📝</span>
            <span data-i18n="demo.enterprise.tabLogs">Audit Logs</span>
            <span class="w-2 h-2 rounded-full bg-emerald-500 ml-1"></span>
          </button>
        </div>

        <div class="text-[11px] font-mono text-zinc-500 hidden md:flex items-center gap-2">
          <span>Engine: Laravel 11.x</span>
          <span>·</span>
          <span>Format: JSON:API</span>
        </div>
      </div>

      <!-- ── TAB 1: RECORDS & CRUD SIMULATION ── -->
      <div id="tab-panel-records" class="tab-panel">
        
        <!-- Search & Filter Controls -->
        <div class="p-4 sm:p-5 border-b border-zinc-800/80 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-zinc-950/30">
          <div class="relative flex-1 max-w-md">
            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35"></path>
            </svg>
            <input
              type="text"
              id="records-search"
              placeholder="Search by ID or description..."
              data-i18n-placeholder="demo.enterprise.searchPlaceholder"
              class="w-full pl-10 pr-4 py-2 text-xs bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-200 placeholder:text-zinc-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors"
            />
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <!-- Filter Status -->
            <select
              id="filter-status"
              class="px-3 py-2 text-xs bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-300 focus:outline-none focus:border-indigo-500"
            >
              <option value="" data-i18n="demo.enterprise.filterAllStatus">All Status</option>
              <option value="completed" data-i18n="demo.enterprise.filterCompleted">Completed</option>
              <option value="pending" data-i18n="demo.enterprise.filterPending">Pending</option>
              <option value="failed" data-i18n="demo.enterprise.filterFailed">Failed</option>
            </select>

            <!-- Filter Type -->
            <select
              id="filter-type"
              class="px-3 py-2 text-xs bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-300 focus:outline-none focus:border-indigo-500"
            >
              <option value="" data-i18n="demo.enterprise.filterAllTypes">All Types</option>
              <option value="transaction" data-i18n="demo.enterprise.filterTxn">Transactions</option>
              <option value="access" data-i18n="demo.enterprise.filterAcl">Access Control</option>
              <option value="webhook" data-i18n="demo.enterprise.filterWebhook">Webhooks</option>
            </select>

            <!-- Add Record Button (Admin Only) -->
            <button
              type="button"
              id="btn-add-record"
              class="px-3.5 py-2 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors flex items-center gap-1.5 shadow-sm shadow-indigo-600/30"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
              </svg>
              <span data-i18n="demo.enterprise.addRecord">Add Record</span>
            </button>
          </div>
        </div>

        <!-- Table View -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-zinc-950/60 border-b border-zinc-800/80 text-zinc-400 font-mono text-[11px] uppercase tracking-wider">
              <tr>
                <th class="px-5 py-3 font-medium" data-i18n="demo.enterprise.thId">Identifier</th>
                <th class="px-5 py-3 font-medium" data-i18n="demo.enterprise.thType">Type</th>
                <th class="px-5 py-3 font-medium" data-i18n="demo.enterprise.thDesc">Description</th>
                <th class="px-5 py-3 font-medium" data-i18n="demo.enterprise.thStatus">Status</th>
                <th class="px-5 py-3 font-medium" data-i18n="demo.enterprise.thTimestamp">Timestamp</th>
                <th class="px-5 py-3 font-medium text-right" data-i18n="demo.enterprise.thActions">Actions</th>
              </tr>
            </thead>
            <tbody id="records-table-body" class="divide-y divide-zinc-800/50">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>

        <!-- Pagination Bar -->
        <div class="p-4 sm:px-6 border-t border-zinc-800/80 flex items-center justify-between text-xs text-zinc-400 bg-zinc-950/30">
          <div id="pagination-info" class="font-mono text-[11px]">
            Showing 1–6 of 15 records
          </div>
          <div class="flex items-center gap-1.5" id="pagination-controls">
            <!-- Buttons rendered via JS -->
          </div>
        </div>
      </div>

      <!-- ── TAB 2: REST API ENDPOINT INSPECTOR ── -->
      <div id="tab-panel-api" class="tab-panel hidden p-4 sm:p-6 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-zinc-800/80">
          <div>
            <h3 class="text-sm font-semibold text-white">Interactive REST API Endpoint Inspector</h3>
            <p class="text-xs text-zinc-400 mt-0.5">Directly inspect production routes, HTTP headers, status codes, and JSON response bodies.</p>
          </div>
          <span class="text-xs font-mono px-2.5 py-1 rounded bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">Base: /api/v1</span>
        </div>

        <!-- Endpoints Accordion -->
        <div class="space-y-3" id="api-endpoints-accordion">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- ── TAB 3: AUDIT LOGS ── -->
      <div id="tab-panel-logs" class="tab-panel hidden p-4 sm:p-6 space-y-3">
        <div class="flex items-center justify-between pb-3 border-b border-zinc-800/80">
          <div>
            <h3 class="text-sm font-semibold text-white">Immutable System Audit Trail</h3>
            <p class="text-xs text-zinc-400 mt-0.5">Append-only compliance log capturing all administrative mutations and session events.</p>
          </div>
          <button
            type="button"
            id="btn-clear-logs"
            class="text-[11px] font-mono text-zinc-500 hover:text-zinc-300 transition-colors"
          >
            Reset Simulator
          </button>
        </div>

        <div class="space-y-2 font-mono text-xs" id="audit-logs-container">
          <!-- Populated by JS -->
        </div>
      </div>

