---
// Live Infrastructure Status Widget — real telemetry from the home server
const services = [
  { id: "nginx", name: "Nginx Proxy", label: "reverse proxy" },
  { id: "docker", name: "Docker Engine", label: "runtime" },
  { id: "n8n", name: "n8n Workflow", label: "automation" },
  { id: "homarr", name: "Homarr Hub", label: "dashboard" },
  { id: "portfolio", name: "Portfolio Web", label: "web server" },
  { id: "cloudflare", name: "Cloudflare", label: "tunnel" },
];
---

<section id="status" class="py-16 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border transition-all duration-200 overflow-hidden section-fade card-base" id="status-widget">
      <!-- Top Terminal Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-zinc-200 dark:border-zinc-800/70 bg-zinc-50/80 dark:bg-zinc-950/40 transition-colors">
        <div class="flex items-center gap-2.5">
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700/80"></span>
          </div>
          <span class="text-xs font-mono text-zinc-600 dark:text-zinc-500 ml-2" data-i18n="status.command">satria@homelab:~# telemetry --live</span>
        </div>

        <div class="flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span id="status-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-zinc-400 opacity-60" style="display:none"></span>
            <span id="status-dot" class="relative inline-flex rounded-full h-2 w-2 bg-zinc-400 dark:bg-zinc-600"></span>
          </span>
          <span id="status-text" class="text-xs font-mono text-zinc-500 font-medium">Connecting…</span>
        </div>
      </div>

      <!-- Main Status Body -->
      <div class="p-6 sm:p-8">
        <!-- Node summary -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-zinc-50/90 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800/60 mb-6 transition-colors">
          <div class="flex items-center gap-3.5">
            <div class="w-9 h-9 rounded-lg bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/50 flex items-center justify-center text-zinc-700 dark:text-zinc-300 shadow-xs">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <p class="font-medium text-sm text-zinc-900 dark:text-zinc-200 transition-colors" data-i18n="status.nodeTitle">Production Node: toshiba-l645</p>
                <span class="inline-flex px-1.5 py-0.5 text-[10px] font-mono text-zinc-600 dark:text-zinc-400 bg-zinc-200 dark:bg-zinc-800 rounded">x86_64</span>
              </div>
              <p id="node-info" class="text-xs text-zinc-500 font-mono mt-0.5">—</p>
            </div>
          </div>

          <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center border-t sm:border-t-0 pt-3 sm:pt-0 border-zinc-200 dark:border-zinc-800/60">
            <span class="text-xs text-zinc-500 font-mono" data-i18n="status.uptimeTitle">Uptime</span>
            <span class="text-xl font-semibold font-mono text-zinc-900 dark:text-zinc-200 transition-colors" id="uptime-display">—</span>
          </div>
        </div>

        <!-- Services Grid -->
        <div class="mb-6">
          <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 mb-3" data-i18n="status.serviceHealth">Service Health Check</div>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5" id="services-grid">
            {services.map((s) => (
              <div data-svc={s.id} class="p-3 rounded-lg bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800/60 hover:border-zinc-300 dark:hover:border-zinc-700/60 transition-colors">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-xs font-medium text-zinc-800 dark:text-zinc-300 truncate">{s.name}</span>
                  <span data-dot class="w-1.5 h-1.5 rounded-full bg-zinc-400 dark:bg-zinc-600"></span>
                </div>
                <div class="flex items-center justify-between text-[11px] font-mono text-zinc-500">
                  <span>{s.label}</span>
                  <span data-ms class="text-zinc-700 dark:text-zinc-400 font-medium">—</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Telemetry Gauges -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5">
          <div class="p-3.5 rounded-lg bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800/60 transition-colors">
            <div class="flex items-center justify-between text-xs font-mono text-zinc-500 mb-1.5">
              <span data-i18n="status.cpu">CPU Core Load</span>
              <span class="text-zinc-900 dark:text-zinc-200 font-medium" id="cpu-stat">—</span>
            </div>
            <div class="h-1 bg-zinc-200 dark:bg-zinc-800 rounded-full overflow-hidden">
              <div id="cpu-bar" class="h-full bg-zinc-800 dark:bg-zinc-400 rounded-full transition-all duration-500" style="width: 0%;"></div>
            </div>
          </div>

          <div class="p-3.5 rounded-lg bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800/60 transition-colors">
            <div class="flex items-center justify-between text-xs font-mono text-zinc-500 mb-1.5">
              <span data-i18n="status.memory">Memory (RAM)</span>
              <span class="text-zinc-900 dark:text-zinc-200 font-medium" id="ram-stat">—</span>
            </div>
            <div class="h-1 bg-zinc-200 dark:bg-zinc-800 rounded-full overflow-hidden">
              <div id="ram-bar" class="h-full bg-zinc-800 dark:bg-zinc-400 rounded-full transition-all duration-500" style="width: 0%;"></div>
            </div>
          </div>

          <div class="p-3.5 rounded-lg bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800/60 transition-colors">
            <div class="flex items-center justify-between text-xs font-mono text-zinc-500 mb-1.5">
              <span>SSD Storage</span>
              <span class="text-zinc-900 dark:text-zinc-200 font-medium" id="disk-stat">—</span>
            </div>
            <div class="h-1 bg-zinc-200 dark:bg-zinc-800 rounded-full overflow-hidden">
              <div id="disk-bar" class="h-full bg-zinc-800 dark:bg-zinc-400 rounded-full transition-all duration-500" style="width: 0%;"></div>
            </div>
          </div>

          <div class="p-3.5 rounded-lg bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800/60 transition-colors">
            <div class="flex items-center justify-between text-xs font-mono text-zinc-500 mb-1.5">
              <span data-i18n="status.containers">Containers</span>
              <span class="text-zinc-900 dark:text-zinc-200 font-medium" id="containers-stat">—</span>
            </div>
            <div class="h-1 bg-zinc-200 dark:bg-zinc-800 rounded-full overflow-hidden">
              <div id="containers-bar" class="h-full bg-zinc-800 dark:bg-zinc-400 rounded-full transition-all duration-500" style="width: 0%;"></div>
            </div>
          </div>
        </div>

        <!-- Last Updated -->
        <div class="mt-5 flex items-center justify-between text-[11px] font-mono text-zinc-500">
          <span id="polling-text">Polling interval: 30s &bull; Agent: —</span>
          <span><span data-i18n="status.lastSync">Last sync:</span> <span id="last-updated">—</span></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { startTelemetry, type Telemetry } from "../lib/telemetry";

  type Tone = "up" | "down" | "off";
  type Data = Telemetry & { containersTotal?: number | null };

  // Class ditulis lengkap (jangan dirakit) supaya Tailwind ikut membundelnya
  const DOT:  Record<Tone, string> = { up: "bg-emerald-500", down: "bg-red-500", off: "bg-zinc-400 dark:bg-zinc-600" };
  const PING: Record<Tone, string> = { up: "bg-emerald-500", down: "bg-red-500", off: "bg-zinc-400" };
  const TEXT: Record<Tone, string> = {
    up: "text-emerald-600 dark:text-emerald-400",
    down: "text-amber-600 dark:text-amber-400",
    off: "text-zinc-500",
  };

  // Teks dinamis ditangani di sini (bukan data-i18n) supaya tidak ditimpa saat ganti bahasa
  const T = {
    en: { healthy: "All Nodes Healthy", degraded: "Degraded", offline: "Telemetry Offline", active: "active", agentOn: "active", agentOff: "unreachable", polling: "Polling interval: 30s" },
    id: { healthy: "Semua Node Sehat", degraded: "Terganggu", offline: "Telemetri Offline", active: "aktif", agentOn: "aktif", agentOff: "tidak terjangkau", polling: "Interval polling: 30d" },
  };
  const lang = () => (document.documentElement.getAttribute("lang") === "id" ? "id" : "en");

  const root = document.getElementById("status-widget");
  const $ = (id: string) => document.getElementById(id);
  const setText = (id: string, v: string) => { const el = $(id); if (el) el.textContent = v; };
  const setBar = (id: string, pct: number) => {
    const el = $(id);
    if (el) el.style.width = `${Math.max(0, Math.min(100, pct))}%`;
  };
  const retone = (el: Element | null, map: Record<Tone, string>, tone: Tone) => {
    if (!el) return;
    Object.values(map).forEach((c) => el.classList.remove(...c.split(" ")));
    el.classList.add(...map[tone].split(" "));
  };

  const setStatus = (tone: Tone, msg: string) => {
    setText("status-text", msg);
    retone($("status-text"), TEXT, tone);
    retone($("status-dot"), DOT, tone);
    const ping = $("status-ping");
    if (ping) {
      retone(ping, PING, tone);
      ping.style.display = tone === "off" ? "none" : "";
    }
  };

  const setCards = (d: Data | null) => {
    root?.querySelectorAll<HTMLElement>("[data-svc]").forEach((card) => {
      const s = d?.services.find((x) => x.id === card.dataset.svc);
      const tone: Tone = !s ? "off" : s.up ? "up" : "down";
      retone(card.querySelector("[data-dot]"), DOT, tone);
      const ms = card.querySelector("[data-ms]");
      if (ms) ms.textContent = !s ? "—" : s.up && s.ms != null ? `${s.ms}ms` : "down";
    });
  };

  function render(d: Data) {
    const t = T[lang()];
    const total = d.services.length;
    const down = d.services.filter((s) => !s.up).length;

    setStatus(down === 0 ? "up" : "down", down === 0 ? t.healthy : `${t.degraded} (${down}/${total})`);

    setText("node-info", [d.node.os, `Linux ${d.node.kernel}`, d.node.docker && `Docker ${d.node.docker}`]
      .filter(Boolean).join(" · "));
    setText("uptime-display", d.uptime30d == null ? "—" : `${d.uptime30d}%`);

    setText("cpu-stat", `${d.cpu.percent}%`);
    setBar("cpu-bar", d.cpu.percent);

    setText("ram-stat", `${d.memory.usedGB} / ${d.memory.totalGB} GB`);
    setBar("ram-bar", d.memory.percent);

    setText("disk-stat", `${d.disk.usedGB} / ${d.disk.totalGB} GB`);
    setBar("disk-bar", d.disk.percent);

    const running = d.containers ?? 0;
    const all = d.containersTotal ?? running;
    setText("containers-stat", d.containers == null ? "—" : `${running} ${t.active}`);
    setBar("containers-bar", all ? (running / all) * 100 : 0);

    setCards(d);
    setText("polling-text", `${t.polling} • Agent: ${t.agentOn}`);
    setText("last-updated", new Date(d.updatedAt * 1000).toLocaleTimeString(
      lang() === "id" ? "id-ID" : "en-US", { hour: "2-digit", minute: "2-digit", second: "2-digit" }));
  }

  // Offline = tampilkan "—", BUKAN angka lama atau palsu
  function offline() {
    const t = T[lang()];
    ["node-info", "uptime-display", "cpu-stat", "ram-stat", "disk-stat", "containers-stat", "last-updated"]
      .forEach((id) => setText(id, "—"));
    ["cpu-bar", "ram-bar", "disk-bar", "containers-bar"].forEach((id) => setBar(id, 0));
    setCards(null);
    setStatus("off", t.offline);
    setText("polling-text", `${t.polling} • Agent: ${t.agentOff}`);
  }

  let state: "init" | "ok" | "off" = "init";
  let last: Data | null = null;

  if (root) {
    startTelemetry(
      (d) => { last = d as Data; state = "ok"; render(last); },
      () => { state = "off"; offline(); },
    );
    // Ganti bahasa: gambar ulang dari data terakhir, tanpa fetch baru
    window.addEventListener("portfolio-lang-change", () => {
      if (state === "ok" && last) render(last);
      else if (state === "off") offline();
    });
  }
</script>