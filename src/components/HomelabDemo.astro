        sslCipher: "TLS_AES_256_GCM_SHA384",
        sslExpiry: "Valid (Auto-Renew via DNS-01 Cloudflare Challenge)",
        snippetTitle: "nginx / proxy_host / 1.conf",
        snippetBody: `server {
  listen 443 ssl http2;
  server_name n8n.satriaimaniar.my.id;

  ssl_certificate /etc/letsencrypt/live/npm-1/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/npm-1/privkey.pem;

  location / {
    proxy_pass http://172.18.0.5:5678;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
  }
}`
      },
      docker: {
        tag: "TARGET SERVICES STACK",
        tagColor: "bg-indigo-500/10 text-indigo-400 border-indigo-500/20",
        title: "Docker Containers Stack (172.18.0.0/16)",
        status: "13 Containers Running",
        protocol: "Internal TCP/HTTP Bridge",
        mechanics: "All application containers (n8n, Homarr, Uptime Kuma) run in an isolated internal Docker bridge network without binding ports to 0.0.0.0 on the host machine. Only Nginx Proxy Manager is networked to communicate with them.",
        sslIssuer: "Internal Bridge (Isolated)",
        sslSubject: "dockernet_default (172.18.0.0/16)",
        sslCipher: "Kernel Netfilter / iptables",
        sslExpiry: "Persistent Bridge",
        snippetTitle: "docker-compose.yml (Homelab Stack)",
        snippetBody: `version: "3.8"
services:
  n8n:
    image: n8nio/n8n:latest
    restart: unless-stopped
    networks:
      - dockernet
    volumes:
      - /opt/stacks/n8n:/home/node/.n8n

  homarr:
    image: ghcr.io/ajnart/homarr:latest
    restart: unless-stopped
    networks:
      - dockernet

networks:
  dockernet:
    external: true`
      }
    };

    // Helper: Show Toast
    function showToast(message) {
      const toast = document.getElementById("demo-toast");
      const msg = document.getElementById("toast-message");
      if (!toast || !msg) return;
      msg.textContent = message;
      toast.classList.remove("translate-y-16", "opacity-0", "pointer-events-none");
      setTimeout(() => {
        toast.classList.add("translate-y-16", "opacity-0", "pointer-events-none");
      }, 3000);
    }

    // Architecture Node Card Click Handlers
    const archCards = document.querySelectorAll(".arch-node-card");
    archCards.forEach((card) => {
      card.addEventListener("click", () => {
        const nodeKey = card.getAttribute("data-node");
        if (!nodeKey || !nodeData[nodeKey]) return;

        // Update active card styling
        archCards.forEach((c) => c.classList.remove("ring-2", "ring-emerald-500/40"));
        card.classList.add("ring-2", "ring-emerald-500/40");

        // Update Inspector
        const data = nodeData[nodeKey];
        const tagEl = document.getElementById("inspect-tag");
        const titleEl = document.getElementById("inspect-title");
        const statusEl = document.getElementById("inspect-status");
        const protoEl = document.getElementById("inspect-protocol");
        const mechEl = document.getElementById("inspect-mechanics");
        const sslIssuerEl = document.getElementById("inspect-ssl-issuer");
        const sslSubjEl = document.getElementById("inspect-ssl-subject");
        const sslCiphEl = document.getElementById("inspect-ssl-cipher");
        const sslExpEl = document.getElementById("inspect-ssl-expiry");
        const snipTitleEl = document.getElementById("code-snippet-title");
        const snipBodyEl = document.getElementById("code-snippet-body");

        if (tagEl) {
          tagEl.textContent = data.tag;
          tagEl.className = "px-2 py-0.5 rounded text-xs font-mono " + data.tagColor;
        }
        if (titleEl) titleEl.textContent = data.title;
        if (statusEl) statusEl.textContent = data.status;
        if (protoEl) protoEl.textContent = data.protocol;
        if (mechEl) mechEl.textContent = data.mechanics;
        if (sslIssuerEl) sslIssuerEl.textContent = data.sslIssuer;
        if (sslSubjEl) sslSubjEl.textContent = data.sslSubject;
        if (sslCiphEl) sslCiphEl.textContent = data.sslCipher;
        if (sslExpEl) sslExpEl.textContent = data.sslExpiry;
        if (snipTitleEl) snipTitleEl.textContent = data.snippetTitle;
        if (snipBodyEl) snipBodyEl.textContent = data.snippetBody;

        showToast(`Inspecting: ${data.title}`);
      });
    });

    // Copy Config Button
    const copyConfigBtn = document.getElementById("btn-copy-config");
    if (copyConfigBtn) {
      copyConfigBtn.addEventListener("click", () => {
        const codeEl = document.getElementById("code-snippet-body");
        if (codeEl) {
          navigator.clipboard.writeText(codeEl.textContent || "");
          showToast("Configuration copied to clipboard!");
        }
      });
    }

    // Ping Service Button Handlers
    const pingButtons = document.querySelectorAll(".btn-ping-service");
    pingButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const service = btn.getAttribute("data-service");
        const latencyEl = document.querySelector(`.service-latency[data-target="${service}"]`);
        
        // Visual feedback
        btn.classList.add("opacity-60");
        setTimeout(() => {
          btn.classList.remove("opacity-60");
          // Generate realistic jitter
          let base = 12;
          if (service === "npm") base = 11 + Math.floor(Math.random() * 4);
          if (service === "docker") base = 3 + Math.floor(Math.random() * 2);
          if (service === "n8n") base = 42 + Math.floor(Math.random() * 8);
          if (service === "homarr") base = 5 + Math.floor(Math.random() * 3);
          if (service === "cloudflare") base = 17 + Math.floor(Math.random() * 5);
          if (service === "kuma") base = 4 + Math.floor(Math.random() * 3);

          if (latencyEl) {
            latencyEl.textContent = `${base}ms`;
          }
          btn.querySelector("span").textContent = `Ping (${base}ms)`;

          // Append to log terminal
          appendLogLine("kuma", `HEARTBEAT probe to ${service} returned 200 OK (${base}ms, jitter: ±0.8ms)`);
          showToast(`Ping ${service}: ${base}ms (Healthy)`);
        }, 400);
      });
    });

    // Restart Service Button Handlers
    const restartButtons = document.querySelectorAll(".btn-restart-service");
    restartButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const service = btn.getAttribute("data-service");
        const card = btn.closest(".p-5");
        const badge = card ? card.querySelector(".service-status-badge") : null;

        if (badge) {
          badge.className = "service-status-badge inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20";
          badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span> RELOADING';
        }

        appendLogLine("docker", `Graceful reload initiated for service [${service}] (SIGTERM sent, worker drain: 2s)`);
        showToast(`Reloading service: ${service}...`);

        setTimeout(() => {
          if (badge) {
            badge.className = "service-status-badge inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20";
            badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> UP';
          }
          appendLogLine("docker", `Service [${service}] active and healthy (1 container restarted, PID fresh)`);
          showToast(`Service ${service} restarted successfully.`);
        }, 1400);
      });
    });

    // Append Log Helper
    const terminalBody = document.getElementById("terminal-body");
    const autoscrollCheck = document.getElementById("chk-autoscroll");

    function appendLogLine(source, text) {
      if (!terminalBody) return;
      const now = new Date();
      const timeStr = now.toTimeString().split(" ")[0];

      const div = document.createElement("div");
      div.className = "log-line";
      div.setAttribute("data-source", source);

      let tagColor = "text-emerald-400";
      if (source === "cloudflared") tagColor = "text-cyan-400";
      if (source === "docker") tagColor = "text-blue-400";
      if (source === "n8n") tagColor = "text-rose-400";
      if (source === "nginx") tagColor = "text-emerald-400";
      if (source === "kuma") tagColor = "text-emerald-400";

      div.innerHTML = `<span class="text-zinc-500">[${timeStr}]</span> <span class="${tagColor}">[${source}]</span> <span class="text-zinc-300">${text}</span>`;
      terminalBody.appendChild(div);

      if (autoscrollCheck && autoscrollCheck.checked) {
        terminalBody.scrollTop = terminalBody.scrollHeight;
      }
    }

    // Live Streaming Simulation (Logs & Resource Jitter)
    const logTemplates = [
      { source: "cloudflared", text: "Tunnel routing incoming request host=homarr.satriaimaniar.my.id -> http://172.18.0.4:7575 [200 OK]" },
      { source: "nginx", text: "2026/11/06 23:10:32 [notice] 142#142: SSL handshake TLSv1.3 / TLS_AES_256_GCM_SHA384 client verified" },
      { source: "docker", text: "Container n8n (e91bf4d13a94) health status: healthy, 0 errors in stream" },
      { source: "kuma", text: "HEARTBEAT probe to https://status.satriaimaniar.my.id [200 OK] (5ms)" },
      { source: "n8n", text: "Workflow [Daily-System-Telemetry-Check] executed successfully in 128ms" },
      { source: "cloudflared", text: "INF Registered tunnel connection connIndex=1 location=SIN protocol=quic ip=198.41.200.194" },
      { source: "docker", text: "Container uptime-kuma metrics collection completed (active_monitors=14)" }
    ];

     function runStreamTick() {
      if (!isLiveStreaming) return;
      
      // Randomly pick a log entry
      const randomLog = logTemplates[Math.floor(Math.random() * logTemplates.length)];
      appendLogLine(randomLog.source, randomLog.text);

      // Subtle resource jitter
      const cpuVal = 17 + Math.floor(Math.random() * 6); // 17% - 22%
      const cpuValEl = document.getElementById("metric-cpu-val");
      const cpuBarEl = document.getElementById("bar-cpu");
      if (cpuValEl) cpuValEl.textContent = `${cpuVal}%`;
      if (cpuBarEl) cpuBarEl.style.width = `${cpuVal}%`;

      // Core micro-bars
      const c0 = 19 + Math.floor(Math.random() * 7);
      const c1 = 15 + Math.floor(Math.random() * 6);
      const c2 = 18 + Math.floor(Math.random() * 5);
      const c3 = 16 + Math.floor(Math.random() * 6);
      
      const c0El = document.getElementById("c0-val");
      const c0Bar = document.getElementById("c0-bar");
      const c1El = document.getElementById("c1-val");
      const c1Bar = document.getElementById("c1-bar");
      const c2El = document.getElementById("c2-val");
      const c2Bar = document.getElementById("c2-bar");
      const c3El = document.getElementById("c3-val");
      const c3Bar = document.getElementById("c3-bar");

      if (c0El) c0El.textContent = `${c0}%`;
      if (c0Bar) c0Bar.style.width = `${c0}%`;
      if (c1El) c1El.textContent = `${c1}%`;
      if (c1Bar) c1Bar.style.width = `${c1}%`;
      if (c2El) c2El.textContent = `${c2}%`;
      if (c2Bar) c2Bar.style.width = `${c2}%`;
      if (c3El) c3El.textContent = `${c3}%`;
      if (c3Bar) c3Bar.style.width = `${c3}%`;
    }  

    streamInterval = setInterval(runStreamTick, 4000);

    // Countdown Timer for Sync
    const countdownEl = document.getElementById("countdown-text");
    countdownInterval = setInterval(() => {
      countdownSeconds--;
      if (countdownSeconds <= 0) {
        countdownSeconds = 30;
        appendLogLine("system", "Periodic cron telemetry sync completed. All 13 containers verified.");
        const ticker = document.getElementById("ticker-text");
        if (ticker) ticker.innerHTML = 'Last synced: <span class="text-zinc-200">just now</span>';
      }
      if (countdownEl) {
        countdownEl.textContent = `refreshes in ${countdownSeconds}s`;
      }
    }, 1000); 

    // Sync Now Button
     const syncNowBtn = document.getElementById("btn-sync-now");
    if (syncNowBtn) {
      syncNowBtn.addEventListener("click", () => {
        countdownSeconds = 30;
        runStreamTick();
        appendLogLine("system", "Manual telemetry sync triggered by operator satria (host: toshiba-l645).");
        showToast("Telemetry synced with bare-metal host!");
      });
    } 

    // Toggle Live Stream Button
    const toggleStreamBtn = document.getElementById("btn-toggle-stream");
    const streamPulse = document.getElementById("stream-pulse");
    const streamDot = document.getElementById("stream-dot");
    const streamLabel = document.getElementById("stream-label");
    const termStreamStatus = document.getElementById("terminal-stream-status");

    if (toggleStreamBtn) {
      toggleStreamBtn.addEventListener("click", () => {
        isLiveStreaming = !isLiveStreaming;
        if (isLiveStreaming) {
          toggleStreamBtn.className = "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 bg-emerald-500/10 text-emerald-300 border-emerald-500/30 hover:bg-emerald-500/20";
          if (streamPulse) streamPulse.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75";
          if (streamDot) streamDot.className = "relative inline-flex rounded-full h-2 w-2 bg-emerald-500";
          if (streamLabel) streamLabel.textContent = "LIVE";
          if (termStreamStatus) termStreamStatus.textContent = "STREAMING";
          showToast("Live stream resumed.");
        } else {
          toggleStreamBtn.className = "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 bg-zinc-900 text-zinc-400 border-zinc-800 hover:text-white";
          if (streamPulse) streamPulse.className = "hidden";
          if (streamDot) streamDot.className = "relative inline-flex rounded-full h-2 w-2 bg-zinc-500";
          if (streamLabel) streamLabel.textContent = "PAUSED";
          if (termStreamStatus) termStreamStatus.textContent = "PAUSED";
          showToast("Live stream paused.");
        }
      });
    }

    // Terminal Filter Buttons
    const filterBtns = document.querySelectorAll(".log-filter-btn");
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => {
          b.className = "log-filter-btn px-2.5 py-1 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40";
        });
        btn.className = "log-filter-btn px-2.5 py-1 rounded bg-zinc-800 text-white font-medium";

        const filter = btn.getAttribute("data-filter");
        const lines = terminalBody ? terminalBody.querySelectorAll(".log-line") : [];
        lines.forEach((line) => {
          const src = line.getAttribute("data-source");
          if (filter === "all" || src === filter) {
            line.style.display = "";
          } else {
            line.style.display = "none";
          }
        });
      });
    });

    // Clear Logs
    const clearLogsBtn = document.getElementById("btn-clear-logs");
    if (clearLogsBtn) {
      clearLogsBtn.addEventListener("click", () => {
        if (terminalBody) {
          terminalBody.innerHTML = `<div class="log-line text-zinc-500">[System] Terminal buffer cleared. Awaiting events...</div>`;
          showToast("Terminal buffer cleared.");
        }
      });
    }

    // Copy Logs
    const copyLogsBtn = document.getElementById("btn-copy-logs");
    if (copyLogsBtn) {
      copyLogsBtn.addEventListener("click", () => {
        if (terminalBody) {
          navigator.clipboard.writeText(terminalBody.innerText);
          showToast("Terminal logs copied to clipboard!");
        }
      });
    }

    // Interactive CLI Terminal Input
    const termInput = document.getElementById("term-input");
    if (termInput) {
      termInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          const cmd = termInput.value.trim().toLowerCase();
          termInput.value = "";
          if (!cmd) return;

          // Echo user command
          const echoDiv = document.createElement("div");
          echoDiv.className = "log-line text-white font-bold";
          echoDiv.innerHTML = `<span class="text-emerald-400">satria@toshiba-l645:~$</span> ${cmd}`;
          terminalBody.appendChild(echoDiv);

          // Command handling
          if (cmd === "help") {
            appendLogLine("system", "Available commands: docker ps, uptime, tunnel status, free -m, curl -I https://npm.home.lab, neofetch, clear");
          } else if (cmd === "docker ps") {
            const table = `CONTAINER ID   IMAGE                               STATUS          PORTS                     NAMES
e91bf4d13a94   n8nio/n8n:latest                    Up 42 days      0.0.0.0:5678->5678/tcp   n8n-automation
a47f8c021e5b   ghcr.io/ajnart/homarr:latest        Up 42 days      0.0.0.0:7575->7575/tcp   homarr-dashboard
c39b1a84f091   jc21/nginx-proxy-manager:latest     Up 42 days      80/tcp, 443/tcp, 81/tcp  nginx-proxy-manager
d28e71059f12   louislam/uptime-kuma:latest         Up 42 days      0.0.0.0:3001->3001/tcp   uptime-kuma
8f1a9420dc14   cloudflare/cloudflared:latest       Up 42 days      tunnel-connector-quic    cloudflared-daemon
(8 additional worker and cache containers active)`;
            appendLogLine("docker", `<pre class="text-zinc-300 font-mono text-[11px] mt-1">${table}</pre>`);
          } else if (cmd === "uptime") {
            appendLogLine("system", "23:10:45 up 42 days, 18:24,  1 user,  load average: 0.19, 0.22, 0.25");
          } else if (cmd === "tunnel status") {
            appendLogLine("cloudflared", "Tunnel 7c89f2a1 active: 4 connections to CGK & SIN PoPs via QUIC (HTTP/3). 0 dropped packets.");
          } else if (cmd === "free -m") {
            const mem = `               total        used        free      shared  buff/cache   available
Mem:            7854        3412        2814          84        1628        4120
Swap:           4096         512        3584`;
            appendLogLine("system", `<pre class="text-zinc-300 font-mono text-[11px] mt-1">${mem}</pre>`);
          } else if (cmd.startsWith("curl")) {
            const headers = `HTTP/2 200 
server: openresty/1.21.4.1
date: Fri, 06 Nov 2026 23:10:48 GMT
content-type: text/html; charset=UTF-8
strict-transport-security: max-age=31536000; includeSubDomains; preload
x-frame-options: SAMEORIGIN
x-content-type-options: nosniff
cf-cache-status: DYNAMIC
cf-ray: 8df4a912c-CGK`;
            appendLogLine("nginx", `<pre class="text-emerald-400 font-mono text-[11px] mt-1">${headers}</pre>`);
          } else if (cmd === "neofetch") {
            const neo = `       _,met$$$$$gg.          satria@toshiba-l645
    ,g######kgk######g,       -------------------
  ,m##################m,      OS: Ubuntu 22.04.4 LTS x86_64
 :######################:     Host: Satellite L645 PSK0EL-01D00U
 ####'     \`"######"     \`    Kernel: 5.15.0-107-generic
 ####       #######      #    Uptime: 42 days, 18 hours, 24 mins
 ####.     .######'     .     Packages: 1142 (dpkg), 13 (docker)
  'm##################m'      Shell: bash 5.1.16
    'g######kgk######g'       CPU: Intel Core i3 M 380 (4) @ 2.533GHz
       '"met$$$$$gg"'         Memory: 3412MiB / 7854MiB (42.5%)`;
            appendLogLine("system", `<pre class="text-zinc-300 font-mono text-[10px] mt-1 leading-tight">${neo}</pre>`);
          } else if (cmd === "clear") {
            terminalBody.innerHTML = "";
          } else {
            appendLogLine("system", `bash: ${cmd}: command not found. Type 'help' for available commands.`);
          }

          if (autoscrollCheck && autoscrollCheck.checked) {
            terminalBody.scrollTop = terminalBody.scrollHeight;
          }
        }
      });
    }

    // Diagnostic Latency Modal Logic
    const testLatencyBtn = document.getElementById("btn-test-latency");
    const latencyModal = document.getElementById("modal-latency");
    const closeModalBtn = document.getElementById("btn-close-modal");
    const retestBtn = document.getElementById("btn-retest-latency");

    function runLatencyDiagnostic() {
      const hop1 = document.getElementById("ping-hop-1");
      const hop2 = document.getElementById("ping-hop-2");
      const hop3 = document.getElementById("ping-hop-3");
      const hop4 = document.getElementById("ping-hop-4");

      if (hop1) hop1.textContent = "measuring...";
      if (hop2) hop2.textContent = "measuring...";
      if (hop3) hop3.textContent = "measuring...";
      if (hop4) hop4.textContent = "measuring...";

      setTimeout(() => {
        if (hop1) hop1.textContent = `${(1.2 + Math.random() * 0.8).toFixed(1)} ms`;
      }, 200);

      setTimeout(() => {
        if (hop2) hop2.textContent = `${(2.8 + Math.random() * 1.1).toFixed(1)} ms`;
      }, 450);

      setTimeout(() => {
        if (hop3) hop3.textContent = `${(16.5 + Math.random() * 2.5).toFixed(1)} ms`;
      }, 700);

      setTimeout(() => {
        if (hop4) hop4.textContent = `${(21.0 + Math.random() * 3.0).toFixed(1)} ms`;
        showToast("Latency diagnostic completed: 0% packet loss.");
      }, 950);
    }

    if (testLatencyBtn && latencyModal) {
      testLatencyBtn.addEventListener("click", () => {
        latencyModal.classList.remove("hidden");
        runLatencyDiagnostic();
      });
    }

    if (closeModalBtn && latencyModal) {
      closeModalBtn.addEventListener("click", () => {
        latencyModal.classList.add("hidden");
      });
    }

    if (retestBtn) {
      retestBtn.addEventListener("click", () => {
        runLatencyDiagnostic();
      });
    }

    // Close modal on backdrop click
    if (latencyModal) {
      latencyModal.addEventListener("click", (e) => {
        if (e.target === latencyModal) {
          latencyModal.classList.add("hidden");
        }
      });
    }

  })();
</script>

