---
// HomelabDemo.astro
// Interactive Production Demo for "Self-Hosted Home Server & Cloud Infrastructure"
// Aesthetic inspired by Homarr, Uptime Kuma, and Vercel dark mode.
// Features: CGNAT Bypass Architecture Visualizer, Service Health Check Grid,
// Live System Telemetry Gauges, and Interactive Simulated Server Terminal Stream.
---

<div class="homelab-demo min-h-screen bg-zinc-950 text-zinc-300 font-sans antialiased selection:bg-emerald-500/20 selection:text-emerald-200">

  <!-- ═══════════════ TOP HEADER & GLOBAL NODE STATUS ═══════════════ -->
  <header class="sticky top-0 z-40 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8">
      
      <!-- Brand & Node Identifier -->
      <div class="flex items-center gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shadow-sm shadow-emerald-500/10">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="8" rx="2"></rect>
            <rect x="2" y="14" width="20" height="8" rx="2"></rect>
            <line x1="6" y1="6" x2="6.01" y2="6"></line>
            <line x1="6" y1="18" x2="6.01" y2="18"></line>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-white font-semibold text-sm tracking-tight" data-i18n="demo.homelab.nodeTitle">
              Production Node: toshiba-l645 (Bare-Metal HomeLab)
            </span>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              BARE-METAL
            </span>
          </div>
           <p class="text-[11px] text-zinc-500 hidden sm:block" data-i18n="demo.homelab.nodeSubtitle">
            Ubuntu 22.04 LTS • Linux 5.15 • Docker 24.0.7
            </p>
          </div>

        <!-- Global Status Badge -->
        <div class="hidden xl:flex items-center gap-2 ml-4 pl-4 border-l border-zinc-800/80">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-xs font-mono text-emerald-400" data-i18n="demo.homelab.badge">
            🟢 All Systems Operational (99.7% 30-day Uptime)
          </span>
        </div>

      </div>
      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Test Tunnel Latency Button -->
        <button
          type="button"
          id="btn-test-latency"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-200 hover:text-white bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 rounded-lg transition-colors duration-150 shadow-sm"
          title="Run diagnostic ping against Cloudflare Tunnel & Nginx endpoints"
        >
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"></path>
          </svg>
          <span data-i18n="demo.homelab.testLatency">Test Tunnel Latency</span>
        </button>

        <!-- Toggle Live Stream Button -->
        <button
          type="button"
          id="btn-toggle-stream"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 bg-emerald-500/10 text-emerald-300 border-emerald-500/30 hover:bg-emerald-500/20"
          title="Toggle live telemetry & log streaming"
        >
          <span class="relative flex h-2 w-2">
            <span id="stream-pulse" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span id="stream-dot" class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span id="stream-label" class="font-mono text-[11px] font-semibold">LIVE</span>
        </button>

        <!-- Language Switcher -->
        <button
          type="button"
          class="lang-toggle-btn inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-mono rounded-lg border border-zinc-800 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 transition-colors"
          aria-label="Switch language (EN/ID)"
          title="Switch language"
        >
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="1.5"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
          </svg>
          <span class="lang-indicator-en font-semibold text-white">EN</span>
          <span class="text-zinc-600">/</span>
          <span class="lang-indicator-id text-zinc-500 font-normal">ID</span>
        </button>

        <!-- Back to Portfolio Link -->
        <a
          href="/#projects"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 rounded-lg transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span data-i18n="demo.homelab.back">Back to Portfolio</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ═══════════════ MAIN CONTENT CONTAINER ═══════════════ -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- ── SYSTEM METADATA STRIP ── -->
     <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-3.5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 text-xs    font-mono">
      <div class="flex items-center gap-2">
        <span class="text-zinc-500">Host:</span>
        <span class="text-zinc-200 font-medium">toshiba-l645</span>
      </div>
    <div class="flex items-center gap-2">
        <span class="text-zinc-500">IP (LAN):</span>
        <span class="text-zinc-200">192.168.1.100</span>
        <span class="text-[10px] px-1.5 py-0.2 rounded bg-zinc-800 text-zinc-400">CGNAT</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-zinc-500">Kernel:</span>
        <span class="text-zinc-200">Linux 5.15.0-107</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-zinc-500">Uptime:</span>
        <span class="text-emerald-400 font-semibold" id="sys-uptime-val">42d 18h 24m</span>
      </div>
    </div>

    <!-- ── SECTION 1: LIVE SYSTEM TELEMETRY & RESOURCE METRICS ── -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-mono uppercase tracking-wider text-zinc-500">Bare-Metal Telemetry</span>
          </div>
          <h2 class="text-lg sm:text-xl font-semibold text-white tracking-tight mt-0.5" data-i18n="demo.homelab.telemetryTitle">
            Live System Telemetry & Resource Metrics
          </h2>
        </div>

        <!-- Sync Ticker -->
        <div class="flex items-center gap-2.5 text-xs font-mono text-zinc-400 bg-zinc-900/60 border border-zinc-800/80 px-3 py-1.5 rounded-xl">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="ticker-text">Last synced: <span class="text-zinc-200">just now</span></span>
          <span class="text-zinc-600">•</span>
          <span class="text-zinc-500 text-[11px]" id="countdown-text">refreshes in 30s</span>
          <button
            type="button"
            id="btn-sync-now"
            class="text-zinc-400 hover:text-white transition-colors ml-1 p-0.5"
            title="Sync metrics immediately"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Telemetry Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="telemetry-grid">
        
        <!-- Metric 1: CPU Core Load -->
        <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-all duration-200 group">
          <div class="flex items-center justify-between text-zinc-500 mb-2">
            <span class="text-xs font-medium uppercase tracking-wider">CPU Core Load</span>
            <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                <rect x="9" y="9" width="6" height="6"></rect>
                <line x1="9" y1="1" x2="9" y2="4"></line>
                <line x1="15" y1="1" x2="15" y2="4"></line>
                <line x1="9" y1="20" x2="9" y2="23"></line>
                <line x1="15" y1="20" x2="15" y2="23"></line>
                <line x1="20" y1="9" x2="23" y2="9"></line>
                <line x1="20" y1="14" x2="23" y2="14"></line>
                <line x1="1" y1="9" x2="4" y2="9"></line>
                <line x1="1" y1="14" x2="4" y2="14"></line>
              </svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-bold font-mono text-white tracking-tight" id="metric-cpu-val">19%</span>
            <span class="text-xs text-zinc-400 font-mono">utilization</span>
          </div>
          
          <!-- Progress Bar -->
          <div class="w-full bg-zinc-800 rounded-full h-2 mt-3 overflow-hidden">
            <div id="bar-cpu" class="bg-gradient-to-r from-emerald-500 to-teal-400 h-2 rounded-full transition-all duration-500" style="width: 19%"></div>
          </div>

          <div class="flex items-center justify-between mt-2.5 text-[11px] text-zinc-400 font-mono">
            <span>4 Cores Active</span>
            <span class="text-emerald-400">Temp: ~46°C</span>
          </div>
          
          <!-- Core Micro-bars -->
          <div class="grid grid-cols-4 gap-1.5 mt-3 pt-2.5 border-t border-zinc-800/60">
            <div>
              <div class="flex justify-between text-[10px] text-zinc-500 font-mono mb-1">
                <span>C0</span><span id="c0-val">22%</span>
              </div>
              <div class="w-full bg-zinc-800/80 rounded-full h-1">
                <div id="c0-bar" class="bg-emerald-500 h-1 rounded-full" style="width: 22%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[10px] text-zinc-500 font-mono mb-1">
                <span>C1</span><span id="c1-val">17%</span>
              </div>
              <div class="w-full bg-zinc-800/80 rounded-full h-1">
                <div id="c1-bar" class="bg-emerald-500 h-1 rounded-full" style="width: 17%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[10px] text-zinc-500 font-mono mb-1">
                <span>C2</span><span id="c2-val">19%</span>
              </div>
              <div class="w-full bg-zinc-800/80 rounded-full h-1">
                <div id="c2-bar" class="bg-emerald-500 h-1 rounded-full" style="width: 19%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[10px] text-zinc-500 font-mono mb-1">
                <span>C3</span><span id="c3-val">18%</span>
              </div>
              <div class="w-full bg-zinc-800/80 rounded-full h-1">
                <div id="c3-bar" class="bg-emerald-500 h-1 rounded-full" style="width: 18%"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Metric 2: Memory (RAM) -->
        <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-all duration-200 group">
          <div class="flex items-center justify-between text-zinc-500 mb-2">
            <span class="text-xs font-medium uppercase tracking-wider">Memory (RAM)</span>
            <div class="w-7 h-7 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                <line x1="6" y1="18" x2="6" y2="21"></line>
                <line x1="10" y1="18" x2="10" y2="21"></line>
                <line x1="14" y1="18" x2="14" y2="21"></line>
                <line x1="18" y1="18" x2="18" y2="21"></line>
              </svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-bold font-mono text-white tracking-tight" id="metric-ram-val">3.4 GB</span>
            <span class="text-xs text-zinc-400 font-mono">/ 8.0 GB</span>
          </div>

          <!-- Progress Bar -->
          <div class="w-full bg-zinc-800 rounded-full h-2 mt-3 overflow-hidden">
            <div id="bar-ram" class="bg-gradient-to-r from-indigo-500 to-cyan-400 h-2 rounded-full transition-all duration-500" style="width: 42.5%"></div>
          </div>

          <div class="flex items-center justify-between mt-2.5 text-[11px] text-zinc-400 font-mono">
            <span class="text-emerald-400 font-medium">Optimized (42.5%)</span>
            <span>Swap: 512M / 4G</span>
          </div>

          <!-- Sub-breakdown -->
          <div class="mt-3 pt-2.5 border-t border-zinc-800/60 flex items-center justify-between text-[11px] font-mono text-zinc-400">
            <span>Cached: 1.8 GB</span>
            <span>Free: 2.8 GB</span>
          </div>
        </div>

        <!-- Metric 3: Storage (NVMe/SSD) -->
        <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-all duration-200 group">
          <div class="flex items-center justify-between text-zinc-500 mb-2">
            <span class="text-xs font-medium uppercase tracking-wider">Storage (NVMe/SSD)</span>
            <div class="w-7 h-7 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
              </svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-bold font-mono text-white tracking-tight" id="metric-storage-val">187 GB</span>
            <span class="text-xs text-zinc-400 font-mono">/ 500 GB</span>
          </div>

          <!-- Progress Bar -->
          <div class="w-full bg-zinc-800 rounded-full h-2 mt-3 overflow-hidden">
            <div id="bar-storage" class="bg-gradient-to-r from-cyan-500 to-emerald-400 h-2 rounded-full transition-all duration-500" style="width: 37.4%"></div>
          </div>

          <div class="flex items-center justify-between mt-2.5 text-[11px] text-zinc-400 font-mono">
            <span>37.4% Used (ext4)</span>
            <span class="text-emerald-400">Health: PASSED</span>
          </div>

          <!-- Sub-breakdown -->
          <div class="mt-3 pt-2.5 border-t border-zinc-800/60 flex items-center justify-between text-[11px] font-mono text-zinc-400">
            <span>Docker: 45 GB</span>
            <span>I/O: 420 IOPS</span>
          </div>
        </div>

        <!-- Metric 4: Active Containers -->
        <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-all duration-200 group">
          <div class="flex items-center justify-between text-zinc-500 mb-2">
            <span class="text-xs font-medium uppercase tracking-wider">Active Containers</span>
            <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-bold font-mono text-emerald-400 tracking-tight" id="metric-containers-val">13</span>
            <span class="text-xs text-zinc-400 font-mono">running / 0 stopped</span>
          </div>

          <!-- Status bar indicators -->
          <div class="flex items-center gap-1 mt-3">
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
            <span class="flex-1 h-2 rounded-full bg-emerald-500"></span>
          </div>

          <div class="flex items-center justify-between mt-2.5 text-[11px] text-zinc-400 font-mono">
            <span class="text-emerald-400">100% Health Score</span>
            <span>Daemon: active</span>
          </div>

          <!-- Sub-breakdown -->
          <div class="mt-3 pt-2.5 border-t border-zinc-800/60 flex items-center justify-between text-[11px] font-mono text-zinc-400">
            <span>Net: dockernet</span>
            <span>Driver: overlay2</span>
          </div>
        </div>
      </div>
    </section> 
    <!-- ── SECTION 2: INTERACTIVE ARCHITECTURE / NETWORK VISUALIZER (CGNAT BYPASS) ── -->
    <section class="p-6 sm:p-7 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 backdrop-blur-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span class="text-xs font-mono uppercase tracking-wider text-zinc-500">Zero-Trust Network Topology</span>
          </div>
          <h2 class="text-base sm:text-lg font-semibold text-white tracking-tight mt-0.5" data-i18n="demo.homelab.archTitle">
            Interactive Architecture / Network Visualizer (CGNAT Bypass)
          </h2>
          <p class="text-xs text-zinc-400 mt-1 max-w-2xl" data-i18n="demo.homelab.archSubtitle">
            Traffic flows securely from public clients through Cloudflare Zero-Trust Tunnels directly to local Nginx Proxy Manager and isolated Docker containers — completely bypassing ISP CGNAT with zero port forwarding.
          </p>
        </div>

        <div class="flex items-center gap-2 self-start sm:self-auto text-[11px] font-mono text-zinc-400 bg-zinc-950/70 border border-zinc-800/80 px-3 py-1.5 rounded-lg">
          <span class="text-zinc-500">Click any node to inspect rules & SSL</span>
        </div>
      </div>

      <!-- Flow Sequence Cards (4 Hops) -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-3 relative">
        
        <!-- Node 1: Internet (CGNAT) -->
        <div
          class="arch-node-card cursor-pointer p-4 rounded-xl bg-zinc-950/70 border border-zinc-800 hover:border-emerald-500/50 transition-all duration-200 relative group ring-2 ring-emerald-500/40"
          data-node="cgnat"
          id="arch-card-cgnat"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-500">Hop 1 • Ingress</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-zinc-800 text-zinc-300">Public</span>
          </div>
          <div class="flex items-center gap-2.5 mb-2">
            <div class="w-7 h-7 rounded-lg bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-white">Internet (CGNAT)</h3>
              <p class="text-[11px] font-mono text-zinc-400">Client HTTPS Request</p>
            </div>
          </div>
          <p class="text-xs text-zinc-400 mt-2 leading-relaxed">
            Public clients request domain. Home ISP blocks all inbound ports (100.64.0.0/10 CGNAT pool).
          </p>
          <div class="mt-3 pt-2 border-t border-zinc-800/80 flex items-center justify-between text-[10px] font-mono text-zinc-500">
            <span>TLS 1.3 Handshake</span>
