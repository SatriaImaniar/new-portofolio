---
// Contact Section
---

<section id="contact" class="py-28 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-16 section-fade" id="contact-header">
      <span class="section-label mb-5 inline-flex">
        <span class="w-1 h-1 rounded-full bg-zinc-400 dark:bg-zinc-600"></span>
        <span data-i18n="contact.tag">Contact</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mt-5 mb-3 transition-colors" data-i18n="contact.title">
        Let's Connect
      </h2>
      <p class="text-zinc-600 dark:text-zinc-400 max-w-lg text-[15px] leading-relaxed transition-colors" data-i18n="contact.subtitle">
        Currently available for contract roles, DevOps infrastructure engineering, and workflow automation systems.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 section-fade" id="contact-content">
      <!-- Contact Form -->
      <div class="p-6 sm:p-7 rounded-2xl card-base" id="contact-form-card">
        <h3 class="text-base font-medium text-zinc-900 dark:text-zinc-200 mb-5 transition-colors" data-i18n="contact.formTitle">Send a Message</h3>
        <form id="contact-form" class="space-y-4" novalidate>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-mono text-zinc-600 dark:text-zinc-400 mb-1.5" data-i18n="contact.nameLabel">Name</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                placeholder="Jane Doe"
                data-i18n-placeholder="contact.namePlaceholder"
                required
                class="w-full px-3.5 py-2.5 bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-lg text-zinc-900 dark:text-zinc-100 text-sm placeholder-zinc-400 dark:placeholder-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-mono text-zinc-600 dark:text-zinc-400 mb-1.5" data-i18n="contact.emailLabel">Email</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                placeholder="jane@company.com"
                data-i18n-placeholder="contact.emailPlaceholder"
                required
                class="w-full px-3.5 py-2.5 bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-lg text-zinc-900 dark:text-zinc-100 text-sm placeholder-zinc-400 dark:placeholder-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors"
              />
            </div>
          </div>
          <div>
            <label for="contact-subject" class="block text-xs font-mono text-zinc-600 dark:text-zinc-400 mb-1.5" data-i18n="contact.subjectLabel">Subject</label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              placeholder="Infrastructure Project / Collaboration"
              data-i18n-placeholder="contact.subjectPlaceholder"
              class="w-full px-3.5 py-2.5 bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-lg text-zinc-900 dark:text-zinc-100 text-sm placeholder-zinc-400 dark:placeholder-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors"
            />
          </div>
          <div>
            <label for="contact-message" class="block text-xs font-mono text-zinc-600 dark:text-zinc-400 mb-1.5" data-i18n="contact.messageLabel">Message</label>
            <textarea
              id="contact-message"
              name="message"
              rows={4}
              placeholder="Tell me about your project scope, requirements, or architecture..."
              data-i18n-placeholder="contact.messagePlaceholder"
              required
              class="w-full px-3.5 py-2.5 bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-lg text-zinc-900 dark:text-zinc-100 text-sm placeholder-zinc-400 dark:placeholder-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            id="contact-submit"
            class="w-full py-2.5 px-5 bg-zinc-900 hover:bg-zinc-800 text-white dark:bg-zinc-100 dark:hover:bg-white dark:text-zinc-900 font-medium rounded-lg transition-colors text-sm flex items-center justify-center gap-2 shadow-sm"
          >
            <span data-i18n="contact.sendBtn">Send Message</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </form>
      </div>

      <!-- Direct Contact & Channels -->
      <div class="flex flex-col justify-between gap-6" id="contact-links">
        <div class="space-y-3">
          <a
            href="mailto:satria.imaniar@gmail.com"
            id="contact-email-link"
            class="flex items-center gap-4 p-4 rounded-xl card-base hover:bg-zinc-50 dark:hover:bg-zinc-900/50 transition-colors group"
          >
            <div class="w-9 h-9 rounded-lg bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/50 flex items-center justify-center text-zinc-600 dark:text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-200 transition-colors flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-mono text-zinc-500" data-i18n="contact.emailDirect">Email Directly</p>
              <p class="text-sm font-medium text-zinc-800 dark:text-zinc-300 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors">satria.imaniar@gmail.com</p>
            </div>
          </a>

          <a
            href="https://github.com/satriaxx"
            target="_blank"
            rel="noopener noreferrer"
            id="contact-github-link"
            class="flex items-center gap-4 p-4 rounded-xl card-base hover:bg-zinc-50 dark:hover:bg-zinc-900/50 transition-colors group"
          >
            <div class="w-9 h-9 rounded-lg bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/50 flex items-center justify-center text-zinc-600 dark:text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-200 transition-colors flex-shrink-0">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-mono text-zinc-500" data-i18n="contact.githubProfile">GitHub Profile</p>
              <p class="text-sm font-medium text-zinc-800 dark:text-zinc-300 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors">github.com/satriaxx</p>
            </div>
          </a>

          <a
            href="https://linkedin.com/in/satria-imaniar"
            target="_blank"
            rel="noopener noreferrer"
            id="contact-linkedin-link"
            class="flex items-center gap-4 p-4 rounded-xl card-base hover:bg-zinc-50 dark:hover:bg-zinc-900/50 transition-colors group"
          >
            <div class="w-9 h-9 rounded-lg bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/50 flex items-center justify-center text-zinc-600 dark:text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-200 transition-colors flex-shrink-0">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-mono text-zinc-500" data-i18n="contact.linkedinProfile">LinkedIn Profile</p>
              <p class="text-sm font-medium text-zinc-800 dark:text-zinc-300 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors">linkedin.com/in/satria-imaniar</p>
            </div>
          </a>
        </div>

        <!-- Availability banner -->
        <div class="p-4 rounded-xl bg-zinc-50 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800/80 flex items-center gap-3 transition-colors">
          <span class="relative flex h-2 w-2 flex-shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-60"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 transition-colors" data-i18n="contact.openRoles">
            Open for remote contracts and production engineering roles.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = (document.getElementById("contact-name") as HTMLInputElement).value;
    const email = (document.getElementById("contact-email") as HTMLInputElement).value;
    const subject = (document.getElementById("contact-subject") as HTMLInputElement).value;
    const message = (document.getElementById("contact-message") as HTMLTextAreaElement).value;

    const mailtoLink = `mailto:satria.imaniar@gmail.com?subject=${encodeURIComponent(subject || "Inquiry from Portfolio")}&body=${encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`)}`;
    window.location.href = mailtoLink;
  });
</script>
