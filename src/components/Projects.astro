---
// Projects Section
import ProjectCard from "./ProjectCard.astro";

const projects = [
  {
    title: "Self-Hosted Home Server & Cloud Infrastructure",
    titleKey: "projects.p1.title",
    description:
      "Architected a resilient self-hosted cloud environment on dedicated bare-metal hardware operating behind an ISP CGNAT without a static public IP. Bypassed networking constraints using Cloudflare Tunnels paired with Nginx Proxy Manager for secure reverse proxying, automated Let's Encrypt SSL certificates, and zero-port-forwarding public exposure.",
    descKey: "projects.p1.desc",
    tags: ["Docker", "Linux", "Cloudflare", "Nginx", "Docker Compose"],
    highlights: [
      "CGNAT Tunnel Bypass",
      "Automated SSL/TLS",
      "Homarr & Portainer Stack",
      "Zero-Trust Access",
    ],
    demoUrl: "",
    githubUrl: "/demo/homelab",
    index: 1,
  },
  {
    title: "AI-Powered Workflow Automation with n8n",
    titleKey: "projects.p2.title",
    description:
      "Engineered an event-driven automation platform connecting distributed APIs, webhooks, and the Gemini LLM engine into autonomous workflows. Automated multi-step data transformation, smart content summarization, and conditional alert routing, eliminating manual intervention across routine operational pipelines.",
    descKey: "projects.p2.desc",
    tags: ["n8n", "Node.js", "Gemini AI", "Webhooks", "REST API"],
    highlights: [
      "LLM API Orchestration",
      "Real-Time Webhooks",
      "Automated Error Alerting",
      "Scheduled ETL Jobs",
    ],
    demoUrl: "/demo/n8n",
    githubUrl: "https://github.com/satriaimaniar",
    index: 2,
  },
  {
    title: "Enterprise Management System & API",
    titleKey: "projects.p3.title",
    description:
      "Built a production-ready enterprise application with fine-grained role-based access control (RBAC), documented RESTful endpoints, and responsive analytics dashboards. Designed for auditability and consistent throughput using Laravel, relational MySQL schemas, and robust input validation.",
    descKey: "projects.p3.desc",
    tags: ["Laravel", "PHP", "MySQL", "REST API", "Tailwind CSS"],
    highlights: [
      "Granular RBAC",
      "Optimized SQL Schemas",
      "Audit Log System",
      "Real-time Metrics",
    ],
    demoUrl: "/demo/enterprise",
    githubUrl: "https://github.com/satriaimaniar",
    index: 3,
  },
];
---

<section id="projects" class="py-28 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-16 section-fade" id="projects-header">
      <span class="section-label mb-5 inline-flex">
        <span class="w-1 h-1 rounded-full bg-zinc-400 dark:bg-zinc-600"></span>
        <span data-i18n="projects.tag">Case Studies</span>
      </span>
      <h2
        class="text-3xl sm:text-4xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mt-5 mb-3 transition-colors"
        data-i18n="projects.title"
      >
        Featured Projects
      </h2>
      <p
        class="text-zinc-600 dark:text-zinc-400 max-w-lg text-[15px] leading-relaxed transition-colors"
        data-i18n="projects.subtitle"
      >
        Production systems, containerized infrastructure, and intelligent
        automation pipelines designed for stability and performance.
      </p>
    </div>

    <!-- Projects Grid -->
    <div
      class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 section-fade"
      id="projects-grid"
    >
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>

    <!-- View More GitHub Button -->
    <div class="text-center mt-14 section-fade">
      <a
        href="https://github.com/satriaimaniar"
        target="_blank"
        rel="noopener noreferrer"
        id="view-github"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors duration-150 text-sm font-medium shadow-sm"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        <span data-i18n="projects.viewGithub"
          >View all repositories on GitHub</span
        >
        <svg
          class="w-3.5 h-3.5 text-zinc-400 dark:text-zinc-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</section>
