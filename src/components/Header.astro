---
// Header / Navigation Component
const navLinks = [
  { label: "About", href: "#about", key: "nav.about" },
  { label: "Skills", href: "#skills", key: "nav.skills" },
  { label: "Projects", href: "#projects", key: "nav.projects" },
  { label: "Experience", href: "#experience", key: "nav.experience" },
  { label: "Contact", href: "#contact", key: "nav.contact" },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between h-14">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" id="header-logo">
        <div class="w-7 h-7 rounded-md bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/60 flex items-center justify-center text-[10px] font-semibold text-zinc-700 dark:text-zinc-300 tracking-wide transition-colors duration-200 group-hover:border-zinc-400 dark:group-hover:border-zinc-500 group-hover:text-zinc-900 dark:group-hover:text-zinc-100">
          SI
        </div>
        <span class="font-medium text-sm text-zinc-600 dark:text-zinc-400 hidden sm:block tracking-tight group-hover:text-zinc-900 dark:group-hover:text-zinc-200 transition-colors duration-200">
          satria<span class="text-zinc-400 dark:text-zinc-600"></span>imaniar
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-0.5" id="desktop-nav">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3 py-1.5 text-[13px] text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 rounded-md transition-colors duration-150 nav-link font-medium"
            data-i18n={link.key}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Action Toggles & CTA -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        <!-- Language Switcher (EN / ID) -->
        <button
          type="button"
          class="lang-toggle-btn inline-flex items-center gap-1 px-2 py-1 text-xs font-mono rounded-md border border-zinc-200 dark:border-zinc-800 bg-zinc-100/70 dark:bg-zinc-900/60 hover:bg-zinc-200/80 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition-colors"
          aria-label="Switch language (EN/ID)"
          title="Switch language"
        >
          <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
          </svg>
          <span class="lang-indicator-en font-semibold text-zinc-900 dark:text-zinc-100 transition-colors">EN</span>
          <span class="text-zinc-400 dark:text-zinc-600 text-[10px]">/</span>
          <span class="lang-indicator-id text-zinc-400 dark:text-zinc-500 font-normal transition-colors">ID</span>
        </button>

        <!-- Light / Dark Mode Toggle -->
        <button
          type="button"
          class="theme-toggle-btn p-1.5 rounded-md border border-zinc-200 dark:border-zinc-800 bg-zinc-100/70 dark:bg-zinc-900/60 hover:bg-zinc-200/80 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition-colors"
          aria-label="Toggle light/dark theme"
          title="Toggle theme"
        >
          <!-- Sun icon (shown when dark) -->
          <svg class="theme-icon-sun w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
          <!-- Moon icon (shown when light) -->
          <svg class="theme-icon-moon w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>

        <!-- CTA Button -->
        <a
          href="#contact"
          id="header-cta"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-[13px] bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 font-medium rounded-md transition-colors duration-150 shadow-sm"
          data-i18n="nav.hireMe"
        >
          Hire Me
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-1.5 rounded-md text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 transition-colors"
          aria-label="Toggle menu"
        >
          <svg id="menu-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-zinc-200/80 dark:border-zinc-800/80 bg-white/95 dark:bg-zinc-950/95 backdrop-blur-xl transition-colors duration-200">
    <div class="max-w-5xl mx-auto px-4 py-3 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-2 text-sm text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/50 rounded-md transition-colors duration-150 mobile-nav-link font-medium"
          data-i18n={link.key}
        >
          {link.label}
        </a>
      ))}

      <!-- Mobile CTA -->
      <a
        href="#contact"
        class="mt-2 px-3 py-2 text-sm bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 font-medium rounded-md text-center transition-colors shadow-sm"
        data-i18n="nav.hireMe"
      >
        Hire Me
      </a>
    </div>
  </div>
</header>

<script>
  // Scroll blur & border styling
  const header = document.getElementById("site-header");
  const updateHeaderScroll = () => {
    if (window.scrollY > 20) {
      header?.classList.add(
        "bg-white/80",
        "dark:bg-zinc-950/80",
        "backdrop-blur-xl",
        "border-b",
        "border-zinc-200/80",
        "dark:border-zinc-800/60"
      );
    } else {
      header?.classList.remove(
        "bg-white/80",
        "dark:bg-zinc-950/80",
        "backdrop-blur-xl",
        "border-b",
        "border-zinc-200/80",
        "dark:border-zinc-800/60"
      );
    }
  };

  window.addEventListener("scroll", updateHeaderScroll);
  updateHeaderScroll();

  // Mobile menu toggle
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");
  let isOpen = false;

  btn?.addEventListener("click", () => {
    isOpen = !isOpen;
    menu?.classList.toggle("hidden", !isOpen);
    menuIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
  });

  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      isOpen = false;
      menu?.classList.add("hidden");
      menuIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    });
  });
</script>
