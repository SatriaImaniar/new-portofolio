---
// HomelabDemo.astro — Tahap 1: semua angka berasal dari agent telemetry (data nyata).
// Hanya field whitelist yang tampil: tanpa IP, nama container, port internal, atau log mentah.
const services = [
  { id: "nginx", name: "Nginx Proxy Manager", sub: "Reverse proxy",
    desc: "Reverse proxy that routes web traffic to the services hosted on this server.",
    box: "bg-emerald-500/10 border-emerald-500/30 text-emerald-400" },
  { id: "docker", name: "Docker Engine", sub: "Container runtime",
    desc: "Container runtime managing lifecycle, resource limits, and bridge networks.",
    box: "bg-blue-500/10 border-blue-500/30 text-blue-400" },
  { id: "n8n", name: "n8n Automation", sub: "Workflow engine",
    desc: "Event-driven workflow engine for webhooks, scheduled jobs, and automations.",
    box: "bg-rose-500/10 border-rose-500/30 text-rose-400" },
  { id: "homarr", name: "Homarr Dashboard", sub: "Control portal",
    desc: "Dashboard with application tiles, service status, and bookmarks.",
    box: "bg-amber-500/10 border-amber-500/30 text-amber-400" },
  { id: "portfolio", name: "Portfolio Web", sub: "This website",
    desc: "The container serving this portfolio, reached through the Cloudflare Tunnel.",
    box: "bg-violet-500/10 border-violet-500/30 text-violet-400" },
  { id: "cloudflare", name: "Cloudflare Tunnel", sub: "Secure edge connector",
    desc: "Outbound-only tunnel carrying public traffic here with no router port forwarding.",
    box: "bg-cyan-500/10 border-cyan-500/30 text-cyan-400" },
];
---

<div class="homelab-demo min-h-screen bg-zinc-950 text-zinc-300 font-sans antialiased selection:bg-emerald-500/20 selection:text-emerald-200">

  <!-- ═══════════════ HEADER ═══════════════ -->
  <header class="sticky top-0 z-40 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8">

      <div class="flex items-center gap-3.5 min-w-0">
        <div class="w-9 h-9 shrink-0 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="8" rx="2"></rect>
            <rect x="2" y="14" width="20" height="8" rx="2"></rect>
            <line x1="6" y1="6" x2="6.01" y2="6"></line>
            <line x1="6" y1="18" x2="6.01" y2="18"></line>
          </svg>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-white font-semibold text-sm tracking-tight truncate" data-i18n="demo.homelab.nodeTitle">
              Production Node: toshiba-l645 (Bare-Metal HomeLab)
            </span>
            <span class="hidden sm:inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              BARE-METAL
            </span>
          </div>
          <p class="text-[11px] text-zinc-500 hidden sm:block" data-tm="nodeInfo">Connecting…</p>
        </div>

        <div class="hidden xl:flex items-center gap-2 ml-4 pl-4 border-l border-zinc-800/80">
          <span class="relative flex h-2 w-2">
            <span data-status-ping class="animate-ping absolute inline-flex h-full w-full rounded-full bg-zinc-500 opacity-75"></span>
            <span data-status-dot class="relative inline-flex rounded-full h-2 w-2 bg-zinc-500"></span>
          </span>
          <span data-status-text data-tm="badge" class="text-xs font-mono text-zinc-500">Connecting…</span>
        </div>
      </div>

      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <button
          type="button"
          class="lang-toggle-btn inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-mono rounded-lg border border-zinc-800 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 transition-colors"
          aria-label="Switch language (EN/ID)"
          title="Switch language"
        >
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="1.5"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
          </svg>
          <span class="lang-indicator-en font-semibold text-white">EN</span>
          <span class="text-zinc-600">/</span>
          <span class="lang-indicator-id text-zinc-500 font-normal">ID</span>
        </button>

        <a
          href="/#projects"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 rounded-lg transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span data-i18n="demo.homelab.back">Back to Portfolio</span>
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- ── HOST STRIP ── -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-3.5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 text-xs font-mono">
      <div class="flex items-center gap-2"><span class="text-zinc-500">Host:</span><span class="text-zinc-200 font-medium" data-tm="host">—</span></div>
      <div class="flex items-center gap-2"><span class="text-zinc-500">Arch:</span><span class="text-zinc-200" data-tm="arch">—</span></div>
      <div class="flex items-center gap-2"><span class="text-zinc-500">Kernel:</span><span class="text-zinc-200" data-tm="kernel">—</span></div>
      <div class="flex items-center gap-2"><span class="text-zinc-500">Uptime:</span><span class="text-emerald-400 font-semibold" data-tm="hostUptime">—</span></div>
    </div>

    <!-- ── SECTION 1: LIVE TELEMETRY ── -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-mono uppercase tracking-wider text-zinc-500">Bare-Metal Telemetry</span>
          </div>
          <h2 class="text-lg sm:text-xl font-semibold text-white tracking-tight mt-0.5" data-i18n="demo.homelab.telemetryTitle">
            Live System Telemetry &amp; Resource Metrics
          </h2>
        </div>
        <div class="flex items-center gap-2.5 text-xs font-mono text-zinc-400 bg-zinc-900/60 border border-zinc-800/80 px-3 py-1.5 rounded-xl">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Last synced: <span class="text-zinc-200" data-tm="lastSync">—</span></span>
          <span class="text-zinc-600">•</span>
          <span class="text-zinc-500 text-[11px]" data-tm="countdown">refreshes in 30s</span>
          <button type="button" id="btn-sync-now" class="text-zinc-400 hover:text-white transition-colors ml-1 p-0.5" title="Sync now" aria-label="Sync now">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- CPU -->
        <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-colors">
          <div class="flex items-center justify-between text-zinc-500 mb-2">
            <span class="text-xs font-medium uppercase tracking-wider">CPU Load</span>
            <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-bold font-mono text-white tracking-tight" data-tm="cpu">—</span>
            <span class="text-xs text-zinc-400 font-mono">utilization</span>
          </div>
          <div class="w-full bg-zinc-800 rounded-full h-2 mt-3 overflow-hidden">
            <div data-bar="cpu" class="bg-gradient-to-r from-emerald-500 to-teal-400 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
          <div class="flex items-center justify-between mt-2.5 text-[11px] text-zinc-400 font-mono">
            <span data-tm="coreCount">—</span>
            <span data-tm="cpuMeta">—</span>
          </div>
          <div data-cores class="grid grid-cols-4 gap-1.5 mt-3 pt-2.5 border-t border-zinc-800/60"></div>
        </div>

        <!-- RAM -->
        <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-colors">
          <div class="flex items-center justify-between text-zinc-500 mb-2">
            <span class="text-xs font-medium uppercase tracking-wider">Memory (RAM)</span>
            <div class="w-7 h-7 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 18v3M10 18v3M14 18v3M18 18v3"/></svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-bold font-mono text-white tracking-tight" data-tm="ram">—</span>
            <span class="text-xs text-zinc-400 font-mono" data-tm="ramTotal">/ —</span>
          </div>
          <div class="w-full bg-zinc-800 rounded-full h-2 mt-3 overflow-hidden">
            <div data-bar="ram" class="bg-gradient-to-r from-indigo-500 to-cyan-400 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
          <div class="flex items-center justify-between mt-2.5 text-[11px] text-zinc-400 font-mono">
            <span class="text-emerald-400 font-medium" data-tm="ramPct">—</span>
            <span data-tm="swap">Swap: —</span>
          </div>
          <div class="mt-3 pt-2.5 border-t border-zinc-800/60 flex items-center justify-between text-[11px] font-mono text-zinc-400">
            <span data-tm="cached">Cached: —</span>
            <span data-tm="avail">Available: —</span>
          </div>
        </div>

        <!-- Storage -->
        <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-colors">
          <div class="flex items-center justify-between text-zinc-500 mb-2">
            <span class="text-xs font-medium uppercase tracking-wider">Storage (SSD)</span>
            <div class="w-7 h-7 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-bold font-mono text-white tracking-tight" data-tm="disk">—</span>
            <span class="text-xs text-zinc-400 font-mono" data-tm="diskTotal">/ —</span>
          </div>
          <div class="w-full bg-zinc-800 rounded-full h-2 mt-3 overflow-hidden">
            <div data-bar="disk" class="bg-gradient-to-r from-cyan-500 to-emerald-400 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
          <div class="flex items-center justify-between mt-2.5 text-[11px] text-zinc-400 font-mono">
            <span data-tm="diskPct">—</span>
            <span>Root partition</span>
          </div>
        </div>

        <!-- Containers -->
        <div class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-colors">
          <div class="flex items-center justify-between text-zinc-500 mb-2">
            <span class="text-xs font-medium uppercase tracking-wider">Active Containers</span>
            <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12"/></svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-bold font-mono text-emerald-400 tracking-tight" data-tm="containers">—</span>
            <span class="text-xs text-zinc-400 font-mono" data-tm="containersOf">running</span>
          </div>
          <div data-container-bars class="flex items-center gap-1 mt-3 h-2"></div>
          <div class="flex items-center justify-between mt-2.5 text-[11px] text-zinc-400 font-mono">
            <span class="text-emerald-400" data-tm="svcSummary">—</span>
            <span data-tm="daemon">Daemon: —</span>
          </div>
          <div class="mt-3 pt-2.5 border-t border-zinc-800/60 text-[11px] font-mono text-zinc-400" data-tm="engine">Engine: —</div>
        </div>

      </div>
    </section>

    <!-- ── SECTION 2: SERVICE HEALTH ── -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-mono uppercase tracking-wider text-zinc-500">Container Fleet</span>
          </div>
          <h2 class="text-base sm:text-lg font-semibold text-white tracking-tight mt-0.5" data-i18n="demo.homelab.servicesTitle">
            Service Health Check Grid (Active Containers)
          </h2>
          <p class="text-xs text-zinc-400 mt-0.5" data-i18n="demo.homelab.servicesSubtitle">
            Live heartbeat checks, container health state, and real-time round-trip latency across the Docker stack.
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-400 self-start sm:self-auto">
          <span data-status-dot class="w-2 h-2 rounded-full bg-zinc-500"></span>
          <span data-tm="svcSummary">—</span>
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {services.map((s) => (
          <div data-svc={s.id} class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 transition-colors">
            <div class="flex items-start justify-between gap-2 mb-3">
              <div class="flex items-center gap-2.5">
                <div class={`w-8 h-8 rounded-lg border flex items-center justify-center ${s.box}`}>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="6" rx="1.5"></rect><rect x="3" y="14" width="18" height="6" rx="1.5"></rect></svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-white">{s.name}</h3>
                  <p class="text-[11px] font-mono text-zinc-500">{s.sub}</p>
                </div>
              </div>
              <span data-badge class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono font-medium border bg-zinc-800 text-zinc-400 border-zinc-700">
                <span data-dot class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
                <span data-state>—</span>
              </span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed mb-4">{s.desc}</p>
            <div class="grid grid-cols-2 gap-2 text-[11px] font-mono text-zinc-400 pt-3 border-t border-zinc-800/60">
              <div>Latency: <span class="text-zinc-200 font-semibold" data-ms>—</span></div>
              <div>Probe: <span class="text-zinc-200">every 15s</span></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <p class="text-[11px] font-mono text-zinc-500 border-t border-zinc-800/60 pt-4">
      Every figure on this page comes from a read-only telemetry agent running on this server. Only whitelisted metrics are exposed: no IP addresses, logs, or private service names.
    </p>

  </main>
</div>

<script>
  import { startTelemetry, fmtUptime, type Telemetry } from "../lib/telemetry";

  type Tone = "up" | "down" | "off";
  type Data = Telemetry & { containersTotal?: number | null };

  // Class ditulis lengkap (jangan dirakit) supaya Tailwind ikut membundelnya
  const DOT: Record<Tone, string> = { up: "bg-emerald-500", down: "bg-red-500", off: "bg-zinc-500" };
  const PING: Record<Tone, string> = { up: "bg-emerald-400", down: "bg-red-400", off: "bg-zinc-500" };
  const TEXT: Record<Tone, string> = { up: "text-emerald-400", down: "text-amber-400", off: "text-zinc-500" };
  const BADGE: Record<Tone, string> = {
    up: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
    down: "bg-red-500/10 text-red-400 border-red-500/20",
    off: "bg-zinc-800 text-zinc-400 border-zinc-700",
  };

  const root = document.querySelector<HTMLElement>(".homelab-demo");
  if (root) {
    const all = (sel: string) => root.querySelectorAll<HTMLElement>(sel);
    const text = (k: string, v: string) => all(`[data-tm="${k}"]`).forEach((el) => (el.textContent = v));
    const bar = (k: string, pct: number) =>
      all(`[data-bar="${k}"]`).forEach((el) => (el.style.width = `${Math.max(0, Math.min(100, pct))}%`));
    const retone = (el: Element | null, map: Record<Tone, string>, tone: Tone) => {
      if (!el) return;
      Object.values(map).forEach((c) => el.classList.remove(...c.split(" ")));
      el.classList.add(...map[tone].split(" "));
    };

    const setStatus = (tone: Tone, msg: string) => {
      text("badge", msg);
      all("[data-status-dot]").forEach((el) => retone(el, DOT, tone));
      all("[data-status-ping]").forEach((el) => {
        retone(el, PING, tone);
        el.classList.toggle("hidden", tone === "off");
      });
      all("[data-status-text]").forEach((el) => retone(el, TEXT, tone));
    };

    const render = (d: Data) => {
      const total = d.services.length;
      const up = d.services.filter((s) => s.up).length;
      const allUp = up === total;

      setStatus(
        allUp ? "up" : "down",
        allUp
          ? `All Systems Operational${d.uptime30d != null ? ` (${d.uptime30d}% uptime)` : ""}`
          : `Degraded: ${total - up} service(s) down`,
      );

      text("nodeInfo", [d.node.os, `Linux ${d.node.kernel}`, d.node.docker && `Docker ${d.node.docker}`].filter(Boolean).join(" • "));
      text("host", d.node.name);
      text("arch", d.node.arch);
      text("kernel", `Linux ${d.node.kernel}`);
      text("hostUptime", d.hostUptimeSec != null ? fmtUptime(d.hostUptimeSec) : "—");

      const cores = d.cpu.cores ?? [];
      text("cpu", `${d.cpu.percent}%`);
      bar("cpu", d.cpu.percent);
      text("coreCount", cores.length ? `${cores.length} Threads` : "—");
      text("cpuMeta", [d.cpu.load1 != null ? `Load ${d.cpu.load1}` : null, d.cpu.tempC != null ? `${d.cpu.tempC}°C` : null]
        .filter(Boolean).join(" · ") || "—");
      all("[data-cores]").forEach((el) => {
        el.innerHTML = cores.map((c, i) => {
          const v = Math.round(Number(c)) || 0;
          return `<div><div class="flex justify-between text-[10px] text-zinc-500 font-mono mb-1"><span>C${i}</span><span>${v}%</span></div>` +
                 `<div class="w-full bg-zinc-800/80 rounded-full h-1"><div class="bg-emerald-500 h-1 rounded-full" style="width:${v}%"></div></div></div>`;
        }).join("");
      });

      text("ram", `${d.memory.usedGB} GB`);
      text("ramTotal", `/ ${d.memory.totalGB} GB`);
      bar("ram", d.memory.percent);
      text("ramPct", `${d.memory.percent}% used`);
      text("swap", d.swap ? `Swap: ${d.swap.usedMB}M / ${d.swap.totalGB}G` : "Swap: —");
      text("cached", d.memory.cachedGB != null ? `Cached: ${d.memory.cachedGB} GB` : "Cached: —");
      text("avail", d.memory.availableGB != null ? `Available: ${d.memory.availableGB} GB` : "Available: —");

      text("disk", `${d.disk.usedGB} GB`);
      text("diskTotal", `/ ${d.disk.totalGB} GB`);
      bar("disk", d.disk.percent);
      text("diskPct", `${d.disk.percent}% used`);

      const running = d.containers ?? 0;
      text("containers", d.containers == null ? "—" : String(running));
      text("containersOf", d.containersTotal != null ? `running / ${Math.max(0, d.containersTotal - running)} stopped` : "running");
      all("[data-container-bars]").forEach((el) => {
        el.innerHTML = '<span class="flex-1 h-2 rounded-full bg-emerald-500"></span>'.repeat(Math.min(running, 24));
      });
      text("svcSummary", `${up}/${total} Services UP`);
      text("daemon", `Daemon: ${d.services.find((s) => s.id === "docker")?.up ? "active" : "down"}`);
      text("engine", `Engine: Docker ${d.node.docker ?? "—"}`);
      text("lastSync", new Date(d.updatedAt * 1000).toLocaleTimeString());

      for (const s of d.services) {
        const card = root.querySelector(`[data-svc="${s.id}"]`);
        if (!card) continue;
        const tone: Tone = s.up ? "up" : "down";
        retone(card.querySelector("[data-badge]"), BADGE, tone);
        retone(card.querySelector("[data-dot]"), DOT, tone);
        const state = card.querySelector("[data-state]");
        if (state) state.textContent = s.up ? "UP" : "DOWN";
        const ms = card.querySelector("[data-ms]");
        if (ms) ms.textContent = s.up && s.ms != null ? `${s.ms}ms` : "—";
      }
    };

    // Offline = tampilkan "—", BUKAN angka lama atau palsu
    const offline = () => {
      all("[data-tm]").forEach((el) => (el.textContent = "—"));
      all("[data-bar]").forEach((el) => (el.style.width = "0%"));
      all("[data-cores], [data-container-bars]").forEach((el) => (el.innerHTML = ""));
      all("[data-svc]").forEach((card) => {
        retone(card.querySelector("[data-badge]"), BADGE, "off");
        retone(card.querySelector("[data-dot]"), DOT, "off");
        const state = card.querySelector("[data-state]");
        if (state) state.textContent = "—";
        const ms = card.querySelector("[data-ms]");
        if (ms) ms.textContent = "—";
      });
      setStatus("off", "Telemetry Offline");
    };

    let left = 30;
    setInterval(() => {
      left = Math.max(0, left - 1);
      text("countdown", `refreshes in ${left}s`);
    }, 1000);

    const refresh = startTelemetry(
      (d) => { left = 30; render(d as Data); },
      () => { left = 30; offline(); },
    );
    document.getElementById("btn-sync-now")?.addEventListener("click", () => refresh());
  }
</script>
