        subtitle: "Rule Evaluator • 2 Dispatch Target Branches",
        description: "Evaluates the Gemini LLM output against workflow business rules. Critical incidents and urgent customer churn issues are dynamically steered to Branch A (High-Priority Telegram Ops Bot), while standard suggestions and feedback route to Branch B (Discord Team Channels).",
        params: [
          { key: "Condition A", val: "category == 'CRITICAL_INCIDENT' || severity == 'CRITICAL'" },
          { key: "Target A", val: "Branch A ➔ Ops Telegram Escalation Bot" },
          { key: "Condition B", val: "DEFAULT (Fallback)" },
          { key: "Target B", val: "Branch B ➔ Discord #product-feedback Webhook" },
          { key: "Evaluation Time", val: "4 ms" }
        ],
        input: {
          "category": "CRITICAL_INCIDENT",
          "severity": "CRITICAL",
          "sentiment": "NEGATIVE_URGENT"
        },
        output: {
          "evaluatedBranch": "Branch A",
          "ruleMatched": "Condition A (Critical Path)",
          "targetChannel": "#incident-triage",
          "notifyImmediate": true
        }
      },
      "node-action": {
        title: "Action / Notification (Telegram / Discord)",
        badge: "ACTION • DISPATCH",
        badgeClass: "bg-emerald-500/20 text-emerald-300 border-emerald-500/30",
        iconColor: "text-emerald-400",
        subtitle: "Telegram Bot API & Discord Webhook Multi-Channel",
        description: "Dispatches formatted markdown messages to operational team channels. Formats rich embeds with severity color bars, Gemini AI summaries, direct links to affected clusters, and token usage telemetry.",
        params: [
          { key: "Telegram Endpoint", val: "https://api.telegram.org/bot<TOKEN>/sendMessage" },
          { key: "Telegram Target", val: "Chat ID: -100192841 (@OpsTriageBot)" },
          { key: "Discord Endpoint", val: "https://discord.com/api/webhooks/982.../tokens" },
          { key: "Parse Mode", val: "MarkdownV2" },
          { key: "Retry Strategy", val: "Exponential Backoff (3 retries max)" }
        ],
        input: {
          "targetBranch": "Branch A",
          "headline": "🚨 CRITICAL_INCIDENT: Postgres Latency Spike (4.8s)",
          "summary": "Master database connection pool exhausted on master-db-01. 42 queries blocked in queue. Immediate failover required.",
          "timestamp": "2026-11-06T23:38:12Z"
        },
        output: {
          "telegramStatus": "200 OK",
          "telegramMessageId": 92841,
          "discordStatus": "204 No Content (Delivered)",
          "deliveredAt": "2026-11-06T23:38:12.418Z",
          "totalPipelineLatency": "304ms"
        }
      }
    };

    // Preset configurations for simulator
    const presets = {
      "db-latency": {
        source: "monitoring.datadog",
        severity: "CRITICAL",
        cluster: "ap-southeast-3 (Jakarta)",
        payload: "Postgres connection pool exhausted on master-db-01. Latency spike: 4,820ms (>500ms threshold). 42 queries blocked in queue. Immediate failover required.",
        category: "CRITICAL_INCIDENT",
        headline: "🚨 CRITICAL_INCIDENT: Postgres Latency Spike (4.8s)",
        summary: "Gemini AI Summary: Master database connection pool exhausted on master-db-01. 42 queries blocked in queue. Immediate failover required.",
        tokens: 192,
        branch: "Branch A (Emergency Ops)",
        channel: "Telegram Bot (@OpsTriageBot)"
      },
      "customer-review": {
        source: "shopify.webhook.review",
        severity: "HIGH",
        cluster: "us-east-1 (N. Virginia)",
        payload: "Terrible experience! Ordered 12 days ago with express shipping (Order #82910) and tracking still says label created. Support bot was completely unhelpful!",
        category: "CUSTOMER_ESCALATION",
        headline: "😡 CUSTOMER_ESCALATION: Severe Delivery Delay (Order #82910)",
        summary: "Gemini AI Summary: Customer reports 12-day shipping delay for express order #82910. High churn risk; requires immediate human support intervention.",
        tokens: 178,
        branch: "Branch A (Emergency Ops)",
        channel: "Telegram Bot (@SupportEscalationBot)"
      },
      "feature-req": {
        source: "feedback.portal",
        severity: "LOW",
        cluster: "eu-west-1 (Ireland)",
        payload: "Loving the new dashboard v1.8! Would be amazing if we could export analytics charts directly into SVG and PDF with dark mode styling.",
        category: "FEATURE_REQUEST",
        headline: "💡 FEATURE_REQUEST: SVG & PDF Dark Mode Export",
        summary: "Gemini AI Summary: User requests capability to export dashboard charts to vector SVG and PDF with native dark mode styling.",
        tokens: 165,
        branch: "Branch B (Standard Discord)",
        channel: "Discord (#product-feedback)"
      },
      "api-throttling": {
        source: "kong.api.gateway",
        severity: "MEDIUM",
        cluster: "ap-northeast-1 (Tokyo)",
        payload: "Client fintech_partner_44 exceeded tier quota of 10,000 req/min (measured: 12,450 req/min). Throttling actively applied.",
        category: "RATE_LIMIT_WARNING",
        headline: "⚠️ RATE_LIMIT_WARNING: Client fintech_partner_44 Throttled",
        summary: "Gemini AI Summary: Partner client throttled after exceeding 10k req/min threshold (12,450 peak). Rate limiting active.",
        tokens: 172,
        branch: "Branch B (Standard Discord)",
        channel: "Discord (#api-alerts)"
      }
    };

    // Helper: Show floating toast
    function showToast(message, isSuccess = true) {
      const toast = document.getElementById("n8n-toast");
      const toastMsg = document.getElementById("toast-message");
      const toastDot = document.getElementById("toast-dot");
      if (!toast || !toastMsg) return;

      toastMsg.textContent = message;
      if (toastDot) {
        toastDot.className = isSuccess ? "w-2 h-2 rounded-full bg-emerald-400" : "w-2 h-2 rounded-full bg-orange-400";
      }

      toast.classList.remove("translate-y-20", "opacity-0", "pointer-events-none");
      toast.classList.add("translate-y-0", "opacity-100");

      setTimeout(() => {
        toast.classList.remove("translate-y-0", "opacity-100");
        toast.classList.add("translate-y-20", "opacity-0", "pointer-events-none");
      }, 3200);
    }

    // Quick Actions: Top Header Buttons
    const btnHeaderTrigger = document.getElementById("btn-header-trigger");
    const btnHeaderLogs = document.getElementById("btn-header-logs");
    const simulatorSection = document.getElementById("simulator-section");
    const logsSection = document.getElementById("logs-section");

    if (btnHeaderTrigger && simulatorSection) {
      btnHeaderTrigger.addEventListener("click", () => {
        simulatorSection.scrollIntoView({ behavior: "smooth", block: "start" });
        const inputPayload = document.getElementById("input-payload");
        if (inputPayload) {
          setTimeout(() => inputPayload.focus(), 500);
        }
      });
    }

    if (btnHeaderLogs && logsSection) {
      btnHeaderLogs.addEventListener("click", () => {
        logsSection.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }

    // Preset Selection Logic
    const presetButtons = document.querySelectorAll(".btn-preset");
    const inputSource = document.getElementById("input-source");
    const inputSeverity = document.getElementById("input-severity");
    const inputCluster = document.getElementById("input-cluster");
    const inputPayload = document.getElementById("input-payload");

    let currentPresetKey = "db-latency";

    presetButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        presetButtons.forEach((b) => {
          b.classList.remove("active", "bg-orange-500/10", "border-orange-500/40", "text-orange-300");
          b.classList.add("bg-zinc-900", "border-zinc-800", "text-zinc-400");
        });

        btn.classList.add("active", "bg-orange-500/10", "border-orange-500/40", "text-orange-300");
        btn.classList.remove("bg-zinc-900", "border-zinc-800", "text-zinc-400");

        const key = btn.getAttribute("data-preset");
        if (key && presets[key]) {
          currentPresetKey = key;
          const p = presets[key];
          if (inputSource) inputSource.value = p.source;
          if (inputSeverity) inputSeverity.value = p.severity;
          if (inputCluster) inputCluster.value = p.cluster;
          if (inputPayload) inputPayload.value = p.payload;
        }
      });
    });

    // Reset Format button
    const btnFormatJson = document.getElementById("btn-format-json");
    if (btnFormatJson && presets[currentPresetKey]) {
      btnFormatJson.addEventListener("click", () => {
        const p = presets[currentPresetKey];
        if (inputPayload) inputPayload.value = p.payload;
        showToast("Payload reset to preset template.");
      });
    }

    // Canvas Reset View Button
    const btnCanvasReset = document.getElementById("btn-canvas-reset");
    if (btnCanvasReset) {
      btnCanvasReset.addEventListener("click", () => {
        showToast("Canvas view centered.");
      });
    }

    // Node Inspector Drawer Elements & Handlers
    const modalNodeInspector = document.getElementById("modal-node-inspector");
    const btnCloseNodeInspector = document.getElementById("btn-close-node-inspector");
    const nodeInspectorBackdrop = document.getElementById("node-inspector-backdrop");
    const workflowNodes = document.querySelectorAll(".workflow-node");

    function openNodeInspector(nodeId) {
      const data = nodeData[nodeId];
      if (!data || !modalNodeInspector) return;

      const titleEl = document.getElementById("drawer-node-title");
      const badgeEl = document.getElementById("drawer-node-badge");
      const subEl = document.getElementById("drawer-node-subtitle");
      const descEl = document.getElementById("drawer-config-desc");
      const paramsContainer = document.getElementById("drawer-config-params");
      const inputJsonEl = document.getElementById("drawer-input-json");
      const outputJsonEl = document.getElementById("drawer-output-json");

      if (titleEl) titleEl.textContent = data.title;
      if (badgeEl) {
        badgeEl.textContent = data.badge;
        badgeEl.className = `px-1.5 py-0.5 rounded text-[10px] font-mono font-medium border ${data.badgeClass}`;
      }
      if (subEl) subEl.textContent = data.subtitle;
      if (descEl) descEl.textContent = data.description;

      if (paramsContainer) {
        paramsContainer.innerHTML = data.params
          .map(
            (p) => `<div class="flex items-start justify-between py-1.5 border-b border-zinc-800/80 gap-2">
            <span class="text-zinc-500 font-medium">${p.key}</span>
            <span class="text-zinc-200 text-right font-semibold">${p.val}</span>
          </div>`
          )
          .join("");
      }

      if (inputJsonEl) inputJsonEl.textContent = JSON.stringify(data.input, null, 2);
      if (outputJsonEl) outputJsonEl.textContent = JSON.stringify(data.output, null, 2);

      modalNodeInspector.classList.remove("hidden");
    }

    workflowNodes.forEach((node) => {
      node.addEventListener("click", () => {
        const nodeId = node.getAttribute("data-node-id");
        if (nodeId) openNodeInspector(nodeId);
      });
    });

    function closeNodeInspector() {
      if (modalNodeInspector) modalNodeInspector.classList.add("hidden");
    }

    if (btnCloseNodeInspector) btnCloseNodeInspector.addEventListener("click", closeNodeInspector);
    if (nodeInspectorBackdrop) nodeInspectorBackdrop.addEventListener("click", closeNodeInspector);

    // Drawer Tabs
    const drawerTabs = document.querySelectorAll(".drawer-tab");
    const tabConfig = document.getElementById("tab-content-config");
    const tabInput = document.getElementById("tab-content-input");
    const tabOutput = document.getElementById("tab-content-output");

    drawerTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        drawerTabs.forEach((t) => {
          t.classList.remove("active", "border-b-2", "border-orange-500", "text-orange-400");
          t.classList.add("text-zinc-400");
        });
        tab.classList.add("active", "border-b-2", "border-orange-500", "text-orange-400");
        tab.classList.remove("text-zinc-400");

        const targetTab = tab.getAttribute("data-tab");
        if (tabConfig) tabConfig.classList.toggle("hidden", targetTab !== "config");
        if (tabInput) tabInput.classList.toggle("hidden", targetTab !== "input");
        if (tabOutput) tabOutput.classList.toggle("hidden", targetTab !== "output");
      });
    });

    // Copy Drawer JSON
    document.querySelectorAll(".btn-copy-drawer-json").forEach((btn) => {
      btn.addEventListener("click", () => {
        const pre = btn.closest(".space-y-3")?.querySelector("pre");
        if (pre) {
          navigator.clipboard.writeText(pre.textContent || "");
          showToast("Node payload copied to clipboard.");
        }
      });
    });

    // Copy Output JSON Button
    const btnCopyJson = document.getElementById("btn-copy-json");
    const outputJsonCode = document.getElementById("output-json-code");
    if (btnCopyJson && outputJsonCode) {
      btnCopyJson.addEventListener("click", () => {
        navigator.clipboard.writeText(outputJsonCode.textContent || "");
        showToast("Output JSON copied to clipboard.");
      });
    }

    // ═══════════════ RUN WORKFLOW SIMULATION ═══════════════
    const btnRunWorkflow = document.getElementById("btn-run-workflow");
    const runSpinner = document.getElementById("run-spinner");
    const runPlayIcon = document.getElementById("run-play-icon");
    const runBtnLabel = document.getElementById("run-btn-label");

    const progressBar = document.getElementById("execution-progress-bar");
    const progressPct = document.getElementById("execution-progress-pct");
    const stageLabel = document.getElementById("execution-stage-label");

    const stepBadges = [
      document.getElementById("step-1"),
      document.getElementById("step-2"),
      document.getElementById("step-3"),
      document.getElementById("step-4"),
      document.getElementById("step-5"),
    ];

    const connectors = [
      document.querySelector("#connector-1 .connector-glow"),
      document.querySelector("#connector-2 .connector-glow"),
      document.querySelector("#connector-3 .connector-glow"),
      document.querySelector("#connector-4 .connector-glow"),
    ];

    const canvasStatusText = document.getElementById("canvas-status-text");
    const canvasTimeText = document.getElementById("canvas-time-text");
    const metricTotalRuns = document.getElementById("metric-total-runs");
    const alertHeadline = document.getElementById("alert-headline");
    const alertSummary = document.getElementById("alert-summary");
    const alertTime = document.getElementById("alert-time");
    const outputDurationTag = document.getElementById("output-duration-tag");

    let isRunning = false;
    let totalRunsCount = 1428;

    if (btnRunWorkflow) {
      btnRunWorkflow.addEventListener("click", () => {
        if (isRunning) return;
        isRunning = true;

        // UI active state
        btnRunWorkflow.classList.add("opacity-75", "cursor-not-allowed");
        if (runSpinner) runSpinner.classList.remove("hidden");
        if (runPlayIcon) runPlayIcon.classList.add("hidden");
        if (runBtnLabel) runBtnLabel.textContent = "Executing Pipeline...";

        // Reset steps & connectors
        stepBadges.forEach((b) => {
          if (b) {
            b.classList.remove("text-emerald-400", "font-semibold");
            b.classList.add("text-zinc-500");
            const icon = b.querySelector(".step-icon");
            if (icon) icon.className = "step-icon w-3.5 h-3.5 rounded-full border border-zinc-700 flex items-center justify-center text-[9px]";
          }
        });
        connectors.forEach((c) => {
          if (c) c.classList.remove("opacity-100");
        });

        const activePreset = presets[currentPresetKey] || presets["db-latency"];
        const customText = inputPayload ? inputPayload.value.trim() : activePreset.payload;
        const severityVal = inputSeverity ? inputSeverity.value : activePreset.severity;

        // Step 1: Webhook Received (0 - 20%)
        if (progressBar) progressBar.style.width = "20%";
        if (progressPct) progressPct.textContent = "20%";
        if (stageLabel) stageLabel.textContent = "🟢 Step 1/5: Ingesting Webhook & Authenticating Bearer Token...";
        if (canvasStatusText) canvasStatusText.textContent = "Worker Active: Ingesting HTTP POST /webhook/v1/user-feedback (12ms)";
        highlightNode("node-webhook", true);
        highlightStepBadge(0, true);

        setTimeout(() => {
          // Step 2: Data Sanitizer & Filter (20% - 40%)
          highlightNode("node-webhook", false);
          if (connectors[0]) connectors[0].classList.add("opacity-100");
          highlightNode("node-sanitizer", true);
          highlightStepBadge(0, false, true);
          highlightStepBadge(1, true);

          if (progressBar) progressBar.style.width = "40%";
          if (progressPct) progressPct.textContent = "40%";
          if (stageLabel) stageLabel.textContent = "🟢 Step 2/5: Stripping HTML/XSS & Validating Zod Schema...";
          if (canvasStatusText) canvasStatusText.textContent = "Worker Active: Sanitizing input text & normalizing whitespace (8ms)";
        }, 120);

        setTimeout(() => {
          // Step 3: Gemini AI Inference (40% - 70%)
          highlightNode("node-sanitizer", false);
          if (connectors[1]) connectors[1].classList.add("opacity-100");
          highlightNode("node-gemini", true);
          highlightStepBadge(1, false, true);
          highlightStepBadge(2, true);

          if (progressBar) progressBar.style.width = "70%";
          if (progressPct) progressPct.textContent = "70%";
          if (stageLabel) stageLabel.textContent = "🟢 Step 3/5: Calling Gemini 1.5 Pro (Summarization & Sentiment)...";
          if (canvasStatusText) canvasStatusText.textContent = `Worker Active: Gemini LLM inference running (~${activePreset.tokens} tokens)`;
        }, 250);

        setTimeout(() => {
          // Step 4: Conditional Router (70% - 90%)
          highlightNode("node-gemini", false);
          if (connectors[2]) connectors[2].classList.add("opacity-100");
          highlightNode("node-router", true);
          highlightStepBadge(2, false, true);
          highlightStepBadge(3, true);

          if (progressBar) progressBar.style.width = "90%";
          if (progressPct) progressPct.textContent = "90%";
          if (stageLabel) stageLabel.textContent = `🟢 Step 4/5: Conditional Router ➔ Steered to ${activePreset.branch}...`;
          if (canvasStatusText) canvasStatusText.textContent = `Worker Active: Routing logic evaluated: ${activePreset.branch} selected (4ms)`;
        }, 420);

        setTimeout(() => {
          // Step 5: Action / Notification (90% - 100%)
          highlightNode("node-router", false);
          if (connectors[3]) connectors[3].classList.add("opacity-100");
          highlightNode("node-action", true);
          highlightStepBadge(3, false, true);
          highlightStepBadge(4, true);

          if (progressBar) progressBar.style.width = "100%";
          if (progressPct) progressPct.textContent = "100%";
          if (stageLabel) stageLabel.textContent = `🟢 Step 5/5: Notification dispatched to ${activePreset.channel}!`;
          if (canvasStatusText) canvasStatusText.textContent = `Worker Complete: Alert delivered to ${activePreset.channel} (200 OK)`;
        }, 580);

        setTimeout(() => {
          // Execution Completed Finish State
          highlightNode("node-action", false);
          highlightStepBadge(4, false, true);

          isRunning = false;
          btnRunWorkflow.classList.remove("opacity-75", "cursor-not-allowed");
          if (runSpinner) runSpinner.classList.add("hidden");
          if (runPlayIcon) runPlayIcon.classList.remove("hidden");
          if (runBtnLabel) runBtnLabel.textContent = "Run Workflow Now";

          // Update metrics & output JSON
          totalRunsCount++;
          if (metricTotalRuns) metricTotalRuns.textContent = totalRunsCount.toLocaleString();

          const now = new Date();
          const timeStr = now.toTimeString().split(" ")[0];
          if (alertTime) alertTime.textContent = timeStr;
          if (alertHeadline) alertHeadline.innerHTML = `🚨 <strong class="text-red-400">${activePreset.category}:</strong> ${severityVal} Alert`;
          if (alertSummary) alertSummary.textContent = activePreset.summary;

          const durationMs = 280 + Math.floor(Math.random() * 50);
          if (outputDurationTag) outputDurationTag.textContent = `Duration: ${durationMs}ms`;
          if (canvasTimeText) canvasTimeText.textContent = `Last executed: Just now (${durationMs}ms)`;

          const resultJson = {
            status: "SUCCESS",
            workflowId: `WF-${8093 + (totalRunsCount - 1429)}`,
            executionTimeMs: durationMs,
            nodesExecuted: 5,
            geminiInference: {
              model: "gemini-1.5-pro-latest",
              promptTokens: 135 + Math.floor(Math.random() * 15),
              completionTokens: activePreset.tokens - 135,
              totalTokens: activePreset.tokens,
              category: activePreset.category,
              summary: activePreset.summary.replace("Gemini AI Summary: ", "")
            },
            routerDecision: {
              matchedRule: `severity == '${severityVal}'`,
              targetBranch: activePreset.branch
            },
            dispatcher: {
              channel: activePreset.channel,
              messageId: 92842 + (totalRunsCount - 1429),
              deliveredAt: now.toISOString()
            }
          };

          if (outputJsonCode) {
            outputJsonCode.textContent = JSON.stringify(resultJson, null, 2);
          }

          // Prepend new row to execution logs table
          prependLogRow(resultJson.workflowId, activePreset.source, durationMs);

          showToast(`Workflow ${resultJson.workflowId} completed in ${durationMs}ms! Alert dispatched.`);
        }, 750);
      });
    }

    function highlightNode(nodeId, active) {
      const nodeEl = document.querySelector(`[data-node-id="${nodeId}"]`);
      if (!nodeEl) return;
      if (active) {
        nodeEl.classList.add("ring-2", "ring-orange-400", "scale-102", "shadow-orange-500/30");
      } else {
        nodeEl.classList.remove("ring-2", "ring-orange-400", "scale-102", "shadow-orange-500/30");
      }
    }

    function highlightStepBadge(index, active, completed = false) {
      const b = stepBadges[index];
      if (!b) return;
      const icon = b.querySelector(".step-icon");
      if (active) {
        b.classList.remove("text-zinc-500");
        b.classList.add("text-orange-400", "font-semibold");
        if (icon) icon.className = "step-icon w-3.5 h-3.5 rounded-full border border-orange-400 bg-orange-500/20 text-orange-300 flex items-center justify-center text-[9px] animate-pulse";
      } else if (completed) {
        b.classList.remove("text-zinc-500", "text-orange-400");
        b.classList.add("text-emerald-400", "font-semibold");
        if (icon) icon.className = "step-icon w-3.5 h-3.5 rounded-full border border-emerald-400 bg-emerald-500/20 text-emerald-300 flex items-center justify-center text-[9px]";
      }
    }

    // Helper: Prepend row to Recent Execution Logs Table
    function prependLogRow(wfId, source, durationMs) {
      const tbody = document.getElementById("logs-table-body");
      if (!tbody) return;

      const tr = document.createElement("tr");
      tr.className = "hover:bg-zinc-800/40 transition-colors bg-orange-500/5";
      tr.setAttribute("data-status", "success");
      tr.innerHTML = `
        <td class="py-3 px-4 font-medium text-white flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Inbound Event Triage</span>
          <span class="text-[10px] text-zinc-500 font-normal">#${wfId}</span>
        </td>
        <td class="py-3 px-4 text-zinc-400">${source}</td>
        <td class="py-3 px-4">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            Success
          </span>
        </td>
        <td class="py-3 px-4 text-zinc-300">${durationMs}ms</td>
        <td class="py-3 px-4 text-zinc-400">Just now</td>
        <td class="py-3 px-4 text-right">
          <button type="button" class="btn-inspect-log text-orange-400 hover:text-orange-300 text-xs font-semibold" data-run-id="${wfId}">
            Inspect Run
          </button>
        </td>
      `;

      tbody.insertBefore(tr, tbody.firstChild);

      // Attach inspect handler to new row
      const btnInspect = tr.querySelector(".btn-inspect-log");
      if (btnInspect) {
        btnInspect.addEventListener("click", () => openRunInspector(wfId, durationMs));
      }
    }

    // ═══════════════ RECENT EXECUTION LOGS INSPECTOR & FILTERS ═══════════════
    const modalRunInspector = document.getElementById("modal-run-inspector");
    const btnCloseRunInspector = document.getElementById("btn-close-run-inspector");
    const btnCloseRunInspectorFoot = document.getElementById("btn-close-run-inspector-foot");
    const runInspectorBackdrop = document.getElementById("run-inspector-backdrop");

    function openRunInspector(runId, durationMs = 304) {
      if (!modalRunInspector) return;

      const titleEl = document.getElementById("modal-run-id-title");
      const timeEl = document.getElementById("modal-run-time");
      const payloadEl = document.getElementById("modal-run-payload");

      if (titleEl) titleEl.textContent = `#${runId}`;
      if (timeEl) timeEl.textContent = `${durationMs} ms`;

      if (payloadEl) {
        payloadEl.textContent = JSON.stringify(
          {
            runId: runId,
            status: "COMPLETED_SUCCESS",
            durationMs: durationMs,
            trigger: "HTTP POST /webhook/v1/user-feedback",
            traceWaterfall: {
              webhookAuthMs: 12,
              dataSanitizationMs: 8,
              gemini15ProInferenceMs: durationMs - 74,
              conditionalRoutingMs: 4,
              multiDispatchDeliveryMs: 50
            },
            geminiTelemetry: {
              model: "gemini-1.5-pro-latest",
              tokens: 192,
              latency: `${durationMs - 74}ms`,
              cacheStatus: "HIT"
            },
            dispatchedAlerts: [
              { channel: "Telegram @OpsTriageBot", status: 200 },
              { channel: "Discord #incident-triage", status: 204 }
            ]
          },
          null,
          2
        );
      }

      modalRunInspector.classList.remove("hidden");
    }

    document.querySelectorAll(".btn-inspect-log").forEach((btn) => {
      btn.addEventListener("click", () => {
        const runId = btn.getAttribute("data-run-id") || "WF-8092";
        openRunInspector(runId);
      });
    });

    function closeRunInspector() {
      if (modalRunInspector) modalRunInspector.classList.add("hidden");
    }

    if (btnCloseRunInspector) btnCloseRunInspector.addEventListener("click", closeRunInspector);
    if (btnCloseRunInspectorFoot) btnCloseRunInspectorFoot.addEventListener("click", closeRunInspector);
    if (runInspectorBackdrop) runInspectorBackdrop.addEventListener("click", closeRunInspector);

    // Logs Filtering & Search
    const logFilterButtons = document.querySelectorAll(".log-filter-btn");
    const logSearchInput = document.getElementById("log-search-input");

    function applyLogFilters() {
      const activeBtn = document.querySelector(".log-filter-btn.active");
      const filterStatus = activeBtn ? activeBtn.getAttribute("data-status") : "all";
      const query = (logSearchInput ? logSearchInput.value : "").toLowerCase().trim();

      const rows = document.querySelectorAll("#logs-table-body tr");
      rows.forEach((row) => {
        const rowStatus = row.getAttribute("data-status");
        const rowText = row.textContent?.toLowerCase() || "";

        const matchesStatus = filterStatus === "all" || rowStatus === filterStatus;
        const matchesQuery = !query || rowText.includes(query);

        row.style.display = matchesStatus && matchesQuery ? "" : "none";
      });
    }

    logFilterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        logFilterButtons.forEach((b) => {
          b.classList.remove("active", "bg-zinc-800", "text-white");
          b.classList.add("text-zinc-400");
        });
        btn.classList.add("active", "bg-zinc-800", "text-white");
        btn.classList.remove("text-zinc-400");
        applyLogFilters();
      });
    });

    if (logSearchInput) {
      logSearchInput.addEventListener("input", applyLogFilters);
    }

    // Keyboard ESC shortcut to close any open modal
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeNodeInspector();
        closeRunInspector();
      }
    });

  })();
</script>
