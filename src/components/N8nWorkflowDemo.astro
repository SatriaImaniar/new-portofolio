---
// N8nWorkflowDemo.astro
// Interactive Production Demo for "AI-Powered Workflow Automation with n8n"
// Aesthetics inspired by n8n, Node-RED, and Vercel dark mode.
// Features: Interactive Flowchart Node Canvas, Live Metrics & Telemetry,
// Interactive Trigger Simulator with live progress stepper, JSON payload viewer,
// Dispatched Notification preview, and Recent Execution Logs Table.

const defaultOutputJson = JSON.stringify(
  {
    status: "SUCCESS",
    workflowId: "WF-8092",
    executionTimeMs: 304,
    nodesExecuted: 5,
    geminiInference: {
      model: "gemini-1.5-pro-latest",
      promptTokens: 142,
      completionTokens: 50,
      totalTokens: 192,
      category: "CRITICAL_INCIDENT",
      summary: "Master database connection pool exhausted with critical latency spike of 4.8s. 42 queries blocked."
    },
    routerDecision: {
      matchedRule: "severity == 'CRITICAL'",
      targetBranch: "Branch A (Emergency Ops)"
    },
    dispatcher: {
      channel: "Telegram Bot (@OpsTriageBot)",
      messageId: 92841,
      deliveredAt: "2026-11-06T23:38:12Z"
    }
  },
  null,
  2
);
---

<div class="n8n-demo min-h-screen bg-zinc-950 text-zinc-300 font-sans antialiased selection:bg-orange-500/20 selection:text-orange-200">

  <!-- ═══════════════ TOP HEADER & WORKER STATUS ═══════════════ -->
  <header class="sticky top-0 z-40 border-b border-zinc-800/80 bg-zinc-950/85 backdrop-blur-md">
    <div class="max-w-7xl mx-auto flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8">
      
      <!-- Brand & Worker Identifier -->
      <div class="flex items-center gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-400 shadow-sm shadow-orange-500/10 group cursor-pointer" id="header-brand-icon" title="n8n Production Worker Engine">
          <svg class="w-5 h-5 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-white font-semibold text-sm sm:text-base tracking-tight" data-i18n="demo.n8n.title">
              n8n Automation Engine v1.8 (Production Worker)
            </span>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-orange-500/10 text-orange-400 border border-orange-500/20">
              CLUSTER #1
            </span>
          </div>
          <p class="text-[11px] text-zinc-400 hidden sm:block" data-i18n="demo.n8n.subtitle">
            Autonomous Event-Driven AI Pipeline & Multi-Channel Alert Router
          </p>
        </div>

        <!-- Global Worker Status Badge -->
        <div class="hidden xl:flex items-center gap-2 ml-4 pl-4 border-l border-zinc-800/80">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          <span class="text-xs font-mono text-emerald-400" data-i18n="demo.n8n.badge">
            🟢 Active Workflows: 6 Running • 0 Failed
          </span>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Trigger Manual Execution Button -->
        <button
          type="button"
          id="btn-header-trigger"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-white bg-orange-600 hover:bg-orange-500 border border-orange-500/50 rounded-lg transition-all duration-150 shadow-sm shadow-orange-600/20 active:scale-95"
          title="Scroll to Trigger Simulator & launch workflow"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span class="hidden sm:inline" data-i18n="demo.n8n.triggerManual">Trigger Manual Execution</span>
          <span class="sm:hidden">Trigger</span>
        </button>

        <!-- View Execution Logs Button -->
        <button
          type="button"
          id="btn-header-logs"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-300 hover:text-white bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 rounded-lg transition-colors duration-150 shadow-sm"
          title="View recent execution log audit table"
        >
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
          </svg>
          <span class="hidden md:inline" data-i18n="demo.n8n.viewLogs">View Execution Logs</span>
          <span class="md:hidden">Logs</span>
        </button>

        <!-- Language Switcher (Native Portfolio Integration) -->
        <button
          type="button"
          class="lang-toggle-btn inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-mono rounded-lg border border-zinc-800 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 transition-colors"
          aria-label="Switch language (EN/ID)"
          title="Switch language"
        >
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="1.5"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
          </svg>
          <span class="lang-indicator-en font-semibold text-white">EN</span>
          <span class="text-zinc-600">/</span>
          <span class="lang-indicator-id text-zinc-500 font-normal">ID</span>
        </button>

        <!-- Back to Portfolio Link -->
        <a
          href="/#projects"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-900/70 hover:bg-zinc-800 border border-zinc-800 rounded-lg transition-colors"
          title="Return to Portfolio Featured Projects"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span class="hidden sm:inline" data-i18n="demo.n8n.back">Back to Portfolio</span>
          <span class="sm:hidden">Back</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ═══════════════ MAIN CONTENT CONTAINER ═══════════════ -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- ── SECTION 1: LIVE EXECUTION METRICS & STATS GRID ── -->
    <section aria-labelledby="metrics-heading">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 id="metrics-heading" class="text-sm font-mono uppercase tracking-wider text-zinc-400 flex items-center gap-2" data-i18n="demo.n8n.metricsTitle">
            <span class="w-2 h-2 rounded-full bg-orange-500"></span>
            Live Execution Metrics & Telemetry
          </h2>
          <p class="text-xs text-zinc-500" data-i18n="demo.n8n.metricsSubtitle">
            Continuous performance stats across active production workers
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs font-mono text-zinc-500">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Worker: node-01.ord (Healthy)</span>
        </div>
      </div>

      <!-- 4 High-Impact Telemetry Metric Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Metric 1: Total Executions -->
        <div class="p-4 rounded-xl bg-zinc-900/50 border border-zinc-800/80 hover:border-zinc-700 transition-all duration-200 relative overflow-hidden group">
          <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-orange-500/5 rounded-full blur-xl group-hover:bg-orange-500/10 transition-colors"></div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-zinc-400" data-i18n="demo.n8n.metricExecutions">Total Executions Today</span>
            <div class="w-8 h-8 rounded-lg bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span id="metric-total-runs" class="text-2xl sm:text-3xl font-mono font-bold text-white tracking-tight">1,428</span>
            <span class="text-xs font-mono text-zinc-500">runs</span>
          </div>
          <div class="mt-2 flex items-center justify-between text-[11px]">
            <span class="inline-flex items-center gap-1 font-mono text-emerald-400">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
              </svg>
              +14.2% vs yesterday
            </span>
            <span class="text-zinc-500 font-mono">1,425 ok • 3 retried</span>
          </div>
        </div>

        <!-- Metric 2: Average Speed -->
        <div class="p-4 rounded-xl bg-zinc-900/50 border border-zinc-800/80 hover:border-zinc-700 transition-all duration-200 relative overflow-hidden group">
          <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-cyan-500/5 rounded-full blur-xl group-hover:bg-cyan-500/10 transition-colors"></div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-zinc-400" data-i18n="demo.n8n.metricSpeed">Average Execution Speed</span>
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"></path>
              </svg>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span id="metric-avg-speed" class="text-2xl sm:text-3xl font-mono font-bold text-white tracking-tight">320ms</span>
            <span class="text-xs font-mono text-zinc-500">per workflow</span>
          </div>
          <div class="mt-2 flex items-center justify-between text-[11px]">
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
              p95: 410ms
            </span>
            <span class="text-zinc-500 font-mono">Network 35ms • LLM 210ms</span>
          </div>
        </div>

        <!-- Metric 3: AI Token Consumption -->
        <div class="p-4 rounded-xl bg-zinc-900/50 border border-zinc-800/80 hover:border-zinc-700 transition-all duration-200 relative overflow-hidden group">
          <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-purple-500/5 rounded-full blur-xl group-hover:bg-purple-500/10 transition-colors"></div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-zinc-400" data-i18n="demo.n8n.metricTokens">AI Token Consumption</span>
            <div class="w-8 h-8 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"></path>
              </svg>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span id="metric-tokens" class="text-2xl sm:text-3xl font-mono font-bold text-white tracking-tight">~45.2k</span>
            <span class="text-xs font-mono text-zinc-500">tokens (Optimized)</span>
          </div>
          <div class="mt-2 flex items-center justify-between text-[11px]">
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono bg-purple-500/10 text-purple-400 border border-purple-500/20">
              88.4% Cache Hit
            </span>
            <span class="text-zinc-500 font-mono">Gemini 1.5 Pro</span>
          </div>
        </div>

        <!-- Metric 4: Success Rate -->
        <div class="p-4 rounded-xl bg-zinc-900/50 border border-zinc-800/80 hover:border-zinc-700 transition-all duration-200 relative overflow-hidden group">
          <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-emerald-500/5 rounded-full blur-xl group-hover:bg-emerald-500/10 transition-colors"></div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-zinc-400" data-i18n="demo.n8n.metricSuccess">Success Rate</span>
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="text-2xl sm:text-3xl font-mono font-bold text-emerald-400 tracking-tight">99.8%</span>
            <span class="text-xs font-mono text-zinc-500">uptime</span>
          </div>
          <div class="mt-2 flex items-center justify-between text-[11px]">
            <span class="text-zinc-400 font-mono">0 dropped events</span>
            <span class="text-emerald-400 font-mono">Self-healing retry</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SECTION 2: INTERACTIVE WORKFLOW VISUALIZER (CANVAS NODES PREVIEW) ── -->
    <section class="rounded-2xl bg-zinc-900/40 border border-zinc-800/80 overflow-hidden shadow-xl" aria-labelledby="canvas-heading">
      
      <!-- Canvas Top Toolbar -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 px-5 py-3.5 border-b border-zinc-800/80 bg-zinc-950/60 backdrop-blur-sm">
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <h3 id="canvas-heading" class="text-xs sm:text-sm font-semibold text-white tracking-tight" data-i18n="demo.n8n.canvasTitle">
              AI Pipeline Visualizer & Node Graph
            </h3>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-zinc-800 text-zinc-400 border border-zinc-700/50">
            Active DAG: #WF-8092
          </span>
        </div>

        <div class="flex items-center gap-2 text-xs font-mono text-zinc-400">
          <span class="hidden md:inline-flex items-center gap-1.5 text-[11px] text-zinc-400 bg-zinc-900 px-2.5 py-1 rounded-md border border-zinc-800" data-i18n="demo.n8n.canvasHint">
            <svg class="w-3.5 h-3.5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Click any node to inspect configuration, input JSON payload, and output tokens
          </span>
          <button
            type="button"
            id="btn-canvas-reset"
            class="px-2 py-1 text-[11px] font-mono rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition-colors"
            title="Reset Canvas View"
          >
            Reset View
          </button>
        </div>
      </div>

      <!-- Canvas Visual Board -->
      <div class="relative p-6 sm:p-8 overflow-x-auto select-none" style="background-image: radial-gradient(circle, #27272a 1px, transparent 1px); background-size: 20px 20px; background-color: #09090b;">
        
        <!-- Live execution overlay line indicator -->
        <div id="canvas-status-banner" class="mb-6 flex items-center justify-between p-3 rounded-xl bg-zinc-900/80 border border-zinc-800 backdrop-blur-sm">
          <div class="flex items-center gap-2.5">
            <span id="canvas-pulse-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
            <span id="canvas-status-text" class="text-xs font-mono text-zinc-300">
              Worker Status: Standing by for webhook triggers (HTTP POST /webhook/v1/user-feedback)
            </span>
          </div>
          <span id="canvas-time-text" class="text-[11px] font-mono text-zinc-400">
            Last executed: 2m ago (312ms)
          </span>
        </div>

        <!-- Flowchart Nodes Chain (Horizontal on desktop, flex-wrap on smaller screens) -->
        <div class="min-w-[880px] flex items-center justify-between gap-4 py-4 relative">
          
          <!-- NODE 1: Webhook Trigger (HTTP POST) -->
          <div
            class="workflow-node group relative w-56 rounded-xl bg-zinc-900/90 border-2 border-orange-500/40 hover:border-orange-500 p-3.5 shadow-lg shadow-black/40 cursor-pointer transition-all duration-200 hover:-translate-y-1 hover:shadow-orange-500/10 active:scale-98"
            data-node-id="node-webhook"
            title="Click to inspect Webhook Trigger Configuration & Raw Payload"
          >
            <!-- Node Header -->
            <div class="flex items-center justify-between mb-2">
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-mono font-semibold bg-orange-500/20 text-orange-400 border border-orange-500/30">
                TRIGGER • POST
              </span>
              <span class="node-status-dot w-2 h-2 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400/50"></span>
            </div>
            <!-- Node Body -->
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-lg bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-400 flex-shrink-0 group-hover:scale-105 transition-transform">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <div class="min-w-0">
                <h4 class="text-xs font-semibold text-white truncate group-hover:text-orange-300 transition-colors">
                  Webhook Trigger
                </h4>
                <p class="text-[10px] text-zinc-400 font-mono truncate">
                  /webhook/v1/feedback
                </p>
              </div>
            </div>
            <!-- Node Footnote -->
            <div class="mt-3 pt-2 border-t border-zinc-800/80 flex items-center justify-between text-[10px] font-mono text-zinc-400">
              <span class="truncate">Rate: 60/min</span>
              <span class="text-orange-400 group-hover:underline">Inspect ➔</span>
            </div>
            <!-- Right Output Port Dot -->
            <span class="absolute -right-2 top-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full bg-zinc-900 border-2 border-orange-400 flex items-center justify-center shadow">
              <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
            </span>
          </div>

          <!-- CONNECTOR 1 -> 2 -->
          <div class="node-connector flex-1 flex items-center justify-center relative min-w-[36px]" id="connector-1">
            <div class="w-full h-0.5 bg-zinc-800 relative overflow-hidden rounded">
              <div class="connector-glow absolute inset-0 bg-gradient-to-r from-orange-500 to-cyan-500 opacity-0 transition-opacity duration-300"></div>
            </div>
            <svg class="w-3.5 h-3.5 text-zinc-600 absolute right-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
            </svg>
          </div>

          <!-- NODE 2: Data Sanitizer & Filter -->
          <div
            class="workflow-node group relative w-56 rounded-xl bg-zinc-900/90 border-2 border-cyan-500/40 hover:border-cyan-500 p-3.5 shadow-lg shadow-black/40 cursor-pointer transition-all duration-200 hover:-translate-y-1 hover:shadow-cyan-500/10 active:scale-98"
            data-node-id="node-sanitizer"
            title="Click to inspect Data Sanitizer & Zod Validation Code"
          >
            <!-- Left Input Port Dot -->
            <span class="absolute -left-2 top-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full bg-zinc-900 border-2 border-cyan-400 flex items-center justify-center shadow">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            </span>
            <!-- Node Header -->
            <div class="flex items-center justify-between mb-2">
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-mono font-semibold bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">
                CODE • TRANSFORM
              </span>
              <span class="node-status-dot w-2 h-2 rounded-full bg-emerald-400"></span>
            </div>
            <!-- Node Body -->
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 flex-shrink-0 group-hover:scale-105 transition-transform">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>
              <div class="min-w-0">
                <h4 class="text-xs font-semibold text-white truncate group-hover:text-cyan-300 transition-colors">
                  Data Sanitizer & Filter
                </h4>
                <p class="text-[10px] text-zinc-400 font-mono truncate">
                  XSS Strip • Zod Schema
